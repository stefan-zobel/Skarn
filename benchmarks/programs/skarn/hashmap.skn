// Benchmark: Map[Int, Int] insertion and lookup throughput.
// n=200_000 — identical across Skarn, Python, C++.
use std::env::*

let n = 200000
let mut m: Map[Int, Int] = #{}
gcResetStats()
let t0 = nanoTime()

let mut i = 0
while i < n {
    m[i] = i % 1000
    i = i + 1
}

let mut checksum = 0
let mut j = 0
while j < n {
    checksum = checksum + getOr(m, j, 0)
    j = j + 1
}

let wall_ns = nanoTime() - t0
let g = gcStats()

println("benchmark=hashmap  n=" + toString(n) + "  checksum=" + toString(checksum)
        + "  wall_ns=" + toString(wall_ns) + "  ns/op=" + toString(wall_ns / (n * 2)))
println("gc_collections=" + toString(toInt(g.collections))
        + "  gc_bytes=" + toString(toInt(g.bytesAlloced))
        + "  gc_ns=" + toString(toInt(g.gcNanosTotal)))
