// Benchmark: string allocation via repeated concatenation (O(n^2) copies).
// n=10_000 — identical across Skarn, Python, C++.
use std::env::*

let n = 10000
gcResetStats()
let t0 = nanoTime()
let mut s = ""
let mut i = 0
while i < n {
    s = s + "x"
    i = i + 1
}
let wall_ns = nanoTime() - t0
let g = gcStats()

println("benchmark=strings  n=" + toString(n) + "  len=" + toString(len(s))
        + "  wall_ns=" + toString(wall_ns) + "  ns/iter=" + toString(wall_ns / n))
println("gc_collections=" + toString(toInt(g.collections))
        + "  gc_bytes=" + toString(toInt(g.bytesAlloced))
        + "  gc_ns=" + toString(toInt(g.gcNanosTotal)))
