// Actors -- long-lived functions on their own threads that talk ONLY by messages. An actor is
// started with `spawnActor(f, init)`, gets an inbox, and loops on `inbox.receive()` until it is
// told to stop; anyone holding its address sends it messages with `send(pid, m)`.
//
// OPT-IN: reach these via `use std::actor::*`.
//
// NOTHING IS SHARED. Every message is COPIED into the receiver's heap, so a sender may go on
// changing its own copy. That is why the checker limits what an actor may receive: the message
// type M and the start value must be SENDABLE -- plain data, with no function value, trait object,
// socket, task or inbox anywhere inside (docs/Compiler.md, "Actors"). An ADDRESS (Pid) is plain
// data, so a message may carry the address to reply to.
//
// THE MAIL. `receive` returns a Mail:
//   * Msg(m)             -- a message;
//   * Exited(id, reason) -- an actor THIS one started has faulted (v1 reports crashes only, and
//                           only to the starter), in the same stream as the messages;
//   * Stop               -- the program is ending. Return from the actor function; every later
//                           receive answers Stop again.
// A send to an actor that no longer runs returns false, and the message is dropped.
//
// The main program has an inbox too, taken ONCE with `mainInbox()`, for replies and crash
// reports. Annotate its message type: `let inbox: Inbox[Reply] = mainInbox()`.
//
// Most actors only want their messages until the program ends: `inbox.messages()` is exactly that,
// a lazy iterator that skips exit reports and ends at Stop.
//
//     fn echo(inbox: Inbox[Ask], unused: Int) -> () {
//       for ask in inbox.messages() { send(ask.replyTo, ask.n * 2) }
//     }
//
// MORE THAN ONE INBOX. An actor (or the main program) may make further inboxes with `newInbox()`,
// each with its own message type and address -- typically one per request whose reply it waits
// for, so the reply neither mixes with nor waits behind the rest of its mail. `ask(p, make, ms)`
// is exactly that: it makes a reply inbox, sends `make(replyAddress)`, waits at most `ms` and
// closes the inbox again. Close an inbox you made yourself with `inbox.close()` when you are done;
// the end of the actor closes all of them.
//
// BACK-PRESSURE. An inbox may be BOUNDED: `spawnActorBounded(f, init, n)` starts an actor whose main
// inbox holds at most n messages, and `newBoundedInbox(n)` makes such an extra inbox. A `send` to a
// full inbox WAITS until the receiver has taken a message, so a fast sender is slowed to the pace
// of its receiver instead of filling its memory; `trySend` never waits and reports Full instead.
// Exit reports and Stop always get through. Two actors that each wait to send to the other's full
// inbox wait forever -- the runtime does not detect that.
//
// GENERIC CODE. `actorFn(f)` checks `f` once, as `spawnActor` would, and returns an `ActorFn` that a
// pool or a supervisor can take as a value, send in a message, and start with `a.spawn(init)`. Inside
// a generic function, a new inbox or `ask` may use a type parameter bounded `Sendable` (std::core).

// An actor's address. Only `spawnActor` and `inbox.pid()` make one.
pub struct Pid[M] { id: Int }

// The receiving end of an actor's mailbox: only the actor itself holds it (it cannot be sent).
pub struct Inbox[M] { id: Int }

// Names an actor regardless of its message type -- what an exit report carries.
pub struct ActorId { id: Int }

// What `receive` hands back.
pub enum Mail[M] { Msg(M), Exited(ActorId, String), Stop }

// What the runtime starts: the actor function and its start value, travelling together as the one
// argument an isolate receives. The function is a named top-level function (the checker makes
// sure), which crosses heaps as its function id.
struct ActorStart[M, I] { f: fn(Inbox[M], I) -> (), init: I }

// The trampoline every actor runs: build the actor's own inbox, then call its function.
fn _actorMain[M, I](s: ActorStart[M, I]) -> () {
  let f = s.f
  f(Inbox { id: rawSelfId() }, s.init)
}

// Start `f(inbox, init)` as an actor and return its address.
pub fn spawnActor[M, I](f: fn(Inbox[M], I) -> (), init: I) -> Pid[M] {
  Pid { id: rawSpawnActor(_actorMain, ActorStart { f: f, init: init }) }
}

// Send `m` to the actor at `p`. False if it no longer runs (the message is then dropped).
pub fn send[M](p: Pid[M], m: M) -> Bool { rawSend(p, m) }

// The main program's own inbox. Once per program.
pub fn mainInbox[M]() -> Inbox[M] { Inbox { id: rawMainInbox() } }

// Start `f(inbox, init)` as an actor whose inbox holds at most `capacity` messages: a `send` to it
// waits while it is full.
pub fn spawnActorBounded[M, I](f: fn(Inbox[M], I) -> (), init: I, capacity: Int) -> Pid[M] {
  Pid { id: rawSpawnActorBounded(_actorMain, ActorStart { f: f, init: init }, capacity) }
}

// An actor function as a VALUE that can start actors later, pass through generic code and travel in a
// message -- what a worker pool or a supervisor that restarts its children needs. Only `actorFn(f)`
// makes one, from a named top-level function, and checks it there as `spawnActor` would.
pub struct ActorFn[M, I] { f: fn(Inbox[M], I) -> () }

// The checked value of `f`.
pub fn actorFn[M, I](f: fn(Inbox[M], I) -> ()) -> ActorFn[M, I] { ActorFn { f: f } }

impl[M, I] ActorFn[M, I] {
  // Start an actor running this function with the start value `init`.
  fn spawn(self, init: I) -> Pid[M] {
    Pid { id: rawSpawnActor(_actorMain, ActorStart { f: self.f, init: init }) }
  }

  // Start one whose inbox holds at most `capacity` messages.
  fn spawnBounded(self, init: I, capacity: Int) -> Pid[M] {
    Pid { id: rawSpawnActorBounded(_actorMain, ActorStart { f: self.f, init: init }, capacity) }
  }
}

// What `trySend` reports: the message was queued, the inbox is full (nothing was queued), or the
// receiver no longer runs.
pub enum SendResult { Sent, Full, Gone }

// Send `m` to `p` without ever waiting.
pub fn trySend[M](p: Pid[M], m: M) -> SendResult {
  let r = rawTrySend(p, m)
  if r == 0 { SendResult::Sent } else if r == 1 { SendResult::Full } else { SendResult::Gone }
}

// A further inbox of this actor (or of the main program), with its own message type and address.
// Annotate it: `let rx: Inbox[Reply] = newInbox()`.
pub fn newInbox[M]() -> Inbox[M] { Inbox { id: rawNewInbox(0) } }

// A further inbox that holds at most `capacity` messages.
pub fn newBoundedInbox[M](capacity: Int) -> Inbox[M] {
  if capacity < 1 { panic("newBoundedInbox: the capacity must be at least 1") }
  Inbox { id: rawNewInbox(capacity) }
}

// Why an `ask` got no reply: the receiver no longer runs, no reply came in time, or the program is
// ending.
pub enum AskError { Gone, Timeout, Stopped }

// Request and reply. `make` builds the request from the address to reply to; the reply is awaited
// on an inbox of its own for at most `timeoutMs` (the wait for room in a full receiver comes on
// top), and that inbox is closed again whatever happens, so a late reply is dropped.
//
//     let r = ask(counter, fn(me) { Query::Total(me) }, 1000)
pub fn ask[M, R](p: Pid[M], make: fn(Pid[R]) -> M, timeoutMs: Int) -> Result[R, AskError] {
  let rx: Inbox[R] = newInbox()
  let result = if !send(p, make(rx.pid())) {
    Err(AskError::Gone)
  } else {
    match rx.receiveTimeout(timeoutMs) {
      Some(Mail::Msg(reply)) => Ok(reply),
      Some(_) => Err(AskError::Stopped),
      None => Err(AskError::Timeout)
    }
  }
  rx.close()
  result
}

impl[M] Pid[M] {
  // This actor's id, to compare with the one in an exit report.
  fn actorId(self) -> ActorId { ActorId { id: self.id } }
}

impl[M] Inbox[M] {
  // Wait for the next mail.
  fn receive(self) -> Mail[M] { _mail(self, rawReceive(self, -1)) }

  // Wait at most `ms` milliseconds: None if nothing arrived.
  fn receiveTimeout(self, ms: Int) -> Option[Mail[M]] {
    let kind = rawReceive(self, ms)
    if kind == 0 { None } else { Some(_mail(self, kind)) }
  }

  // The address of the actor this inbox belongs to -- to hand out, e.g. inside a message.
  fn pid(self) -> Pid[M] { Pid { id: self.id } }

  // Close an inbox made with `newInbox`: later sends to it answer false (trySend: Gone), and what
  // it still holds is dropped. The main inbox cannot be closed; it ends with its actor.
  fn close(self) -> () { rawCloseInbox(self) }

  // The messages, one by one, as a lazy iterator that ends at Stop -- so an actor's whole loop can be
  // `for m in inbox.messages() { .. }`. Exit reports are SKIPPED; an actor that needs them (because it
  // starts actors of its own) uses `receive` instead.
  fn messages(self) -> dyn Iterator[M] { MessageStream { inbox: self } }
}

struct MessageStream[M] { inbox: Inbox[M] }

impl[M] Iterator[M] for MessageStream[M] {
  fn next(mut self) -> Option[M] {
    loop {
      match self.inbox.receive() {
        Mail::Msg(m) => break Some(m),
        Mail::Exited(_, _) => {},
        Mail::Stop => break None,
      }
    }
  }
}

fn _mail[M](inbox: Inbox[M], kind: Int) -> Mail[M] {
  if kind == 1 {
    Mail::Msg(rawMailMsg(inbox))
  } else if kind == 2 {
    Mail::Exited(ActorId { id: rawMailFrom(inbox) }, rawMailReason(inbox))
  } else {
    Mail::Stop
  }
}
