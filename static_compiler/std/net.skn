// TCP networking over the std::net natives (tcpConnect / tcpSend / tcpRecv / tcpClose / tcpListen /
// tcpAccept / tcpSetTimeout). The BYTE-oriented core (send/recv over Bytes) is primary; the String
// helpers (sendStr / recvLine / recvAll) sit on top. A socket is a small Int descriptor inside the
// TcpConn / TcpListener wrappers.
//
// The per-connection operations are inherent methods -- call them with dot syntax: `c.send(data)?`,
// `c.recvLine()?`, `l.accept()?`. The constructors (`connect` / `listen` / `httpGet`) have no receiver,
// so they stay free.
//
// OPT-IN: reach these wrappers AND the tcp* natives via `use std::net::*`. Same-module code (these
// wrappers) may call the natives freely.
//
// LIMITS (deliberate): BLOCKING only -- accept/recv block the calling thread, so one thread serves
// ONE connection at a time (std::poll serves many from one thread, and `c.handOff()` below gives a
// connection to another actor, on another thread); PLAINTEXT only (no TLS -> HTTP yes,
// HTTPS no); a socket must be closed explicitly (execute() teardown is only the safety net). Both
// IPv4 and IPv6 are supported (the client tries every resolved address; the server is dual-stack).
//
// ACTIVE CONNECTIONS. An actor that owns a connection and must also react to its inbox cannot block in
// recvLine. `c.activate(framing, capacity)` hands the READING to the runtime, which delivers what
// arrives as SockEvents into an inbox of the actor; `select` then waits on that and the actor's own
// inbox at once. See the ActiveConn section below.

use std::actor::*

// A connected TCP stream. `fd` is the OS socket descriptor; `buf` holds bytes read past a line
// boundary by recvLine (it stays empty for a purely byte-oriented user of send/recv).
pub struct TcpConn { fd: Int, buf: Bytes }

// A listening socket (the server side). Accept incoming connections with `l.accept()`.
pub struct TcpListener { fd: Int }

// --- client / server constructors (no receiver -> free functions) ---

// Connect to host:port. `host` may be a name or an IPv4/IPv6 literal; both address families are tried.
pub fn connect(host: String, port: Int) -> Result[TcpConn, String] {
  let fd = tcpConnect(host, port)?
  Ok(TcpConn { fd: fd, buf: bytes() })
}

// Bind + listen on `port` (dual-stack: accepts both IPv6 and IPv4-mapped clients).
pub fn listen(port: Int) -> Result[TcpListener, String] {
  let fd = tcpListen(port)?
  Ok(TcpListener { fd: fd })
}

// --- buffered-text helper internals (built on the byte core) ---

// Index of the first byte == `target` at or after `from` in `b`, or -1 if none.
fn _indexOfByte(b: Bytes, target: Int, from: Int) -> Int {
  let n = len(b)
  let mut i = from
  let mut found = -1
  while i < n && found < 0 { if b[i] == target { found = i }  i = i + 1 }
  found
}

// The sub-range b[lo, hi) copied into a fresh buffer -- one bulk memcpy (_appendBytesRange) into a
// pre-sized buffer, not a per-byte push loop. recvLine calls this once per line to keep the tail.
fn _sub(b: Bytes, lo: Int, hi: Int) -> Bytes {
  if hi <= lo { bytes() }
  else {
    let mut out = bytes(hi - lo)
    _appendBytesRange(out, b, lo, hi)
    out
  }
}

// --- a connection's own API (dot syntax: c.send(data), c.recvLine(), ...) ---
impl TcpConn {
  // Send a whole byte buffer (loops until every byte is flushed).
  fn send(self, data: Bytes) -> Result[(), String] { tcpSend(self.fd, data) }

  // Send a whole string's bytes.
  fn sendStr(self, s: String) -> Result[(), String] { tcpSend(self.fd, toBytes(s)) }

  // Receive up to `n` bytes. An EMPTY result means the peer closed the connection (EOF).
  fn recv(self, n: Int) -> Result[Bytes, String] { tcpRecv(self.fd, n) }

  // Set the recv/send timeout in milliseconds (<= 0 means block indefinitely, the default).
  fn setTimeout(self, ms: Int) -> Result[(), String] { tcpSetTimeout(self.fd, ms) }

  // Close the connection. A second close of the same socket returns an "invalid socket" Err.
  fn close(self) -> Result[(), String] { tcpClose(self.fd) }

  // Read all remaining bytes until EOF, INCLUDING any bytes buffered by a prior recvLine.
  fn recvAll(mut self) -> Result[Bytes, String] {
    let mut out = bytes()
    appendBytes(out, self.buf)
    self.buf = bytes()
    loop {
      let chunk = tcpRecv(self.fd, 65536)?
      if len(chunk) == 0 { return Ok(out) }
      appendBytes(out, chunk)
    }
  }

  // Read one '\n'-terminated line (the '\n' and a preceding '\r' are stripped). Returns None at EOF
  // with nothing buffered; a final unterminated line is returned once, then None.
  fn recvLine(mut self) -> Result[Option[String], String] {
    loop {
      let idx = _indexOfByte(self.buf, 10, 0)
      if idx >= 0 {
        let end = if idx > 0 && self.buf[idx - 1] == 13 { idx - 1 } else { idx }
        let line = sliceBytes(self.buf, 0, end)
        self.buf = _sub(self.buf, idx + 1, len(self.buf))
        return Ok(Some(line))
      }
      let chunk = tcpRecv(self.fd, 4096)?
      if len(chunk) == 0 {
        if len(self.buf) == 0 { return Ok(None) }
        let last = sliceBytes(self.buf, 0, len(self.buf))
        self.buf = bytes()
        return Ok(Some(last))
      }
      appendBytes(self.buf, chunk)
    }
  }

  // Detach this connection for another actor: the ticket travels, this TcpConn is dead from now
  // on (see SocketHandOff below).
  fn handOff(self) -> Result[SocketHandOff, String] {
    let token = rawHandOff(self.fd)?
    Ok(SocketHandOff { token: token, buf: self.buf })
  }

  // Hand the READING of this connection to the runtime (see ActiveConn below). What arrives comes as
  // SockEvents, cut by `framing`, into an inbox of at most `capacity` events; while it is full the
  // runtime stops reading and TCP holds the peer back. Write through the returned ActiveConn. This
  // TcpConn is dead from now on: every operation on it returns Err("... socket was activated").
  // Bytes recvLine had already read past a line come first. Only an actor or the main program can.
  fn activate(self, framing: Framing, capacity: Int) -> Result[(ActiveConn, SockEvents), String] {
    if capacity < 1 { return Err("activate: the capacity must be 1 or more") }
    let mode = match framing { Framing::Raw => 0, Framing::Lines(_) => 1 }
    let maxLen = match framing { Framing::Raw => 0, Framing::Lines(n) => n }
    let box: Inbox[Bytes] = newBoundedInbox(capacity)
    match rawActivate(self.fd, box, mode, maxLen, self.buf) {
      Ok(id) => Ok((ActiveConn { id: id }, SockEvents { box: box })),
      Err(e) => {
        box.close()
        Err(e)
      }
    }
  }
}

// --- a listener's own API ---
impl TcpListener {
  // Block until a client connects; return the accepted connection.
  fn accept(self) -> Result[TcpConn, String] {
    let fd = tcpAccept(self.fd)?
    Ok(TcpConn { fd: fd, buf: bytes() })
  }

  // The port this listener is actually bound to. Only interesting after `listen(0)`, which asks the
  // OS for a free port instead of naming one -- the right way to run a server on an arbitrary port,
  // since any fixed number can already be taken by an unrelated connection.
  fn localPort(self) -> Result[Int, String] { tcpLocalPort(self.fd) }

  // Stop listening (server self-shutdown).
  fn close(self) -> Result[(), String] { tcpClose(self.fd) }

  // Hand the ACCEPTING to the runtime (see ActiveListener below). Every new connection arrives as
  // Incoming::NewClient(ticket) in an inbox of at most `capacity` events; while it is full the runtime
  // accepts nothing and new clients wait in the operating system's queue. Close through the returned
  // ActiveListener. This TcpListener is dead from now on. Only an actor or the main program can.
  fn activate(self, capacity: Int) -> Result[(ActiveListener, IncomingClients), String] {
    if capacity < 1 { return Err("activate: the capacity must be 1 or more") }
    let box: Inbox[Bytes] = newBoundedInbox(capacity)
    match rawActivateListener(self.fd, box) {
      Ok(id) => Ok((ActiveListener { id: id }, IncomingClients { box: box })),
      Err(e) => {
        box.close()
        Err(e)
      }
    }
  }
}

// --- handing a connection to another actor ---

// A connection on its way to another actor (std::actor). A TcpConn itself cannot be sent -- its
// descriptor means something only in the actor that opened it -- so `c.handOff()` detaches the
// connection and returns this ticket, which CAN be sent, and the receiving actor turns it back into a
// TcpConn with `h.take()`, once. After the hand-off the sender's TcpConn is dead: every operation on
// it returns Err("... socket was handed to another actor"). Bytes already read past a line boundary
// by recvLine travel along. Only std::net creates one.
pub struct SocketHandOff { token: Int, buf: Bytes }

impl SocketHandOff {
  // Take over the connection, in the actor that received the ticket. Once.
  fn take(self) -> Result[TcpConn, String] {
    let fd = rawTake(self.token)?
    Ok(TcpConn { fd: fd, buf: self.buf })
  }
}

// --- active connections (Erlang's active mode) ---
//
// A connection whose READING the runtime has taken over (`c.activate(framing, capacity)`). One thread
// per program reads every active connection and delivers what arrives into an inbox of its owner, as
// SockEvents; the owner waits on them and on its own inbox with `select`:
//
//     let (out, events) = conn.activate(Framing::Lines(4096), 64)?
//     let watching = toVec([events.ref(), inbox.ref()])
//     loop {
//       match select(watching, -1) {
//         Some(0) => match events.receive() {
//           Line(s) => ...,                // a line from the peer
//           _ => return ()                 // Eof, Failed(why) or Stopping
//         },
//         _ => match inbox.receive() { ... }   // a message; answer with out.sendStr(...)
//       }
//     }
//
// Neither half can be sent to another actor: the events are an inbox of this one, and only the actor
// that activated a connection may write to it or close it. The runtime closes it when that actor ends.

// How the input is cut into events: Raw delivers the chunks as they are read (SockEvent::Chunk);
// Lines(max) delivers every line (SockEvent::Line, without its "\n" or "\r\n"), and a line longer than
// `max` bytes ends the stream with SockEvent::Failed.
pub enum Framing { Raw, Lines(Int) }

// What an active connection delivers. Eof is the end of the stream (the peer closed it); after Eof or
// Failed nothing more comes. Stopping is the actor's own Stop: every inbox of an actor gets one when it
// is told to end. The names are deliberately none of Mail's (Stop) or std::poll's (Data, Closed), so a
// program importing all three may write every variant bare.
pub enum SockEvent { Chunk(Bytes), Line(String), Eof, Failed(String), Stopping }

// The writing half. Only `c.activate(...)` makes one.
pub struct ActiveConn { id: Int }

impl ActiveConn {
  // Send a whole byte buffer.
  fn send(self, data: Bytes) -> Result[(), String] { rawActiveSend(self.id, data) }

  // Send a whole string's bytes.
  fn sendStr(self, s: String) -> Result[(), String] { rawActiveSend(self.id, toBytes(s)) }

  // Close the connection. Later sends return an Err, and events not received yet are dropped.
  // Closing twice is fine.
  fn close(self) -> () { rawActiveClose(self.id) }

  // How long a send may wait for a peer that does not read, counted from the last byte that went out.
  // When it runs out the send returns Err("... has not read for <ms> ms ...") and the connection is
  // CLOSED: a message half written would leave the peer mid-message. 0, the default, waits without
  // limit. Either way a waiting send ends with an Err as soon as this actor is told to stop, so a peer
  // that stops reading can never keep its actor -- or the program -- from ending.
  fn setSendTimeout(self, ms: Int) -> () { rawActiveSetSendTimeout(self.id, ms) }
}

// The reading half: an inbox the runtime delivers into. Only `c.activate(...)` makes one.
pub struct SockEvents { box: Inbox[Bytes] }

impl SockEvents {
  // This inbox, for `select`.
  fn ref(self) -> InboxRef { self.box.ref() }

  // The next event; waits for one.
  fn receive(self) -> SockEvent { _sockEvent(self.box.receive()) }

  // The next event, or None if none came within `ms` milliseconds.
  fn receiveTimeout(self, ms: Int) -> Option[SockEvent] {
    match self.box.receiveTimeout(ms) {
      Some(m) => Some(_sockEvent(m)),
      None => None
    }
  }
}

// The runtime's event -- a tag byte, then the payload -- as a SockEvent. An inbox of this kind never
// gets an exit report (nothing can monitor into it), so anything but a message is the actor's Stop,
// which it passes on as Stopping.
fn _sockEvent(m: Mail[Bytes]) -> SockEvent {
  match m {
    Mail::Msg(b) => {
      let tag = b[0]
      let rest = _sub(b, 1, len(b))
      if tag == 0 { SockEvent::Chunk(rest) }
      else if tag == 1 { SockEvent::Line(fromBytes(rest)) }
      else if tag == 2 { SockEvent::Eof }
      else { SockEvent::Failed(fromBytes(rest)) }
    }
    _ => SockEvent::Stopping
  }
}

// --- active listeners ---
//
// A listener whose ACCEPTING the runtime has taken over (`l.activate(capacity)`). The same thread that
// reads active connections accepts, and delivers each new connection as a SocketHandOff ticket -- which
// can be sent on to a worker unchanged, where `take()` turns it into a TcpConn as usual. So an acceptor
// waits on new clients AND its own inbox with `select`, and a Stop reaches it:
//
//     let (lst, incoming) = srv.activate(16)?
//     let watching = toVec([incoming.ref(), inbox.ref()])
//     loop {
//       match select(watching, -1) {
//         Some(0) => match incoming.receive() {
//           NewClient(ticket) => { send(worker, ticket) }
//           _ => return ()                         // AcceptFailed(why) or ListenerStopping
//         },
//         _ => match inbox.receive() { ... }
//       }
//     }
//
// Neither half can be sent to another actor, and the runtime closes the listener when its actor ends.
// Connections accepted but not received yet are closed with it, so no client waits on one nobody gets.

// What an active listener delivers. AcceptFailed ends it (nothing more comes); ListenerStopping is the
// actor's own Stop. The names are none of SockEvent's, Mail's or std::poll's, so all may be written bare.
pub enum Incoming { NewClient(SocketHandOff), AcceptFailed(String), ListenerStopping }

// The listener. Only `l.activate(...)` makes one.
pub struct ActiveListener { id: Int }

impl ActiveListener {
  // Stop listening. Connections accepted but not received yet are closed; closing twice is fine.
  fn close(self) -> () { rawActiveClose(self.id) }
}

// The new clients: an inbox the runtime delivers into. Only `l.activate(...)` makes one.
pub struct IncomingClients { box: Inbox[Bytes] }

impl IncomingClients {
  // This inbox, for `select`.
  fn ref(self) -> InboxRef { self.box.ref() }

  // The next event; waits for one.
  fn receive(self) -> Incoming { _incoming(self.box.receive()) }

  // The next event, or None if none came within `ms` milliseconds.
  fn receiveTimeout(self, ms: Int) -> Option[Incoming] {
    match self.box.receiveTimeout(ms) {
      Some(m) => Some(_incoming(m)),
      None => None
    }
  }
}

// The runtime's event as an Incoming: tag 4 carries a hand-off ticket as decimal text, tag 3 a failure.
fn _incoming(m: Mail[Bytes]) -> Incoming {
  match m {
    Mail::Msg(b) => {
      let rest = fromBytes(_sub(b, 1, len(b)))
      if b[0] == 4 {
        let token = match parseInt(rest) { Ok(t) => t, Err(_) => -1 }
        Incoming::NewClient(SocketHandOff { token: token, buf: bytes() })
      } else {
        Incoming::AcceptFailed(rest)
      }
    }
    _ => Incoming::ListenerStopping
  }
}

// --- a minimal HTTP/1.0 client (the optional text layer; REST = this + std::json) ---

// A parsed HTTP response: the numeric status code and the raw body text (headers past the status
// line are dropped). A JSON body feeds `Json::parse(resp.body)`.
pub struct HttpResponse { status: Int, body: String }

// The status code from an HTTP status line like "HTTP/1.0 200 OK" (the 2nd space-separated token),
// or 0 if it cannot be parsed.
fn _httpStatus(head: String) -> Int {
  let nl = indexOf(head, "\r\n")
  let line = if nl >= 0 { slice(head, 0, nl) } else { head }
  let sp1 = indexOf(line, " ")
  if sp1 < 0 { 0 }
  else {
    let rest = slice(line, sp1 + 1, len(line))
    let sp2 = indexOf(rest, " ")
    let code = if sp2 >= 0 { slice(rest, 0, sp2) } else { rest }
    match parseInt(code) { Ok(n) => n, Err(_) => 0 }
  }
}

// Fetch host:port/path over PLAIN HTTP/1.0 (no TLS -> http:// only, not https://). Sends
// `Connection: close` and reads the whole response to EOF. Only the status + body are kept.
pub fn httpGet(host: String, port: Int, path: String) -> Result[HttpResponse, String] {
  let mut c = connect(host, port)?
  let req = "GET " + path + " HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
  c.sendStr(req)?
  let raw = c.recvAll()?
  c.close()?
  let text = fromBytes(raw)
  let sep = indexOf(text, "\r\n\r\n")
  let headEnd = if sep >= 0 { sep } else { len(text) }
  let bodyStart = if sep >= 0 { sep + 4 } else { len(text) }
  let head = slice(text, 0, headEnd)
  let body = slice(text, bodyStart, len(text))
  Ok(HttpResponse { status: _httpStatus(head), body: body })
}
