// Non-cryptographic hashing. CRC-32 (IEEE 802.3 / zlib / PNG -- reflected, polynomial 0xEDB88320,
// init 0xFFFFFFFF, final XOR 0xFFFFFFFF). Pure Skarn -- no native, no VM change; fully deterministic
// and unit-testable. The result is a NON-NEGATIVE 32-bit Int (0 .. 2^32-1).
//
// NOT cryptographically secure -- CRC-32 is an error-detection checksum, trivially reversible/forgeable.
// Do not use for integrity against an adversary, passwords, or content addressing where collisions matter.
// A cryptographic digest (SHA-256, below) is the separate secure option.
//
// TABLE-DRIVEN: a module-private `const _CRC32_TABLE: Array[Int]` (the standard 256-entry CRC-32 table)
// is built ONCE at startup, so the inner loop is a single table lookup per byte instead of 8 shift/xor
// steps -- ~12x faster than the bitwise form (measured wall-clock, not the op-count estimate: the
// bitwise form does 9 function calls per byte -- 1 `_crcByte` + 8 tail-recursive `_crcBits` -- and VM
// call dispatch dominates; the table loop has zero inner-loop calls). A const array is module-private
// and non-escaping (read-only), so this shared table cannot escape or be mutated. Every table entry and
// intermediate stays a non-negative value < 2^32, so `>>` acts as a logical shift and no sign leaks in.
//
// OPT-IN: reach these via `use std::hash::*` (or a qualified std::hash::name). Tree-shaken when unused.

// The standard CRC-32 lookup table (reflected polynomial 0xEDB88320), one entry per byte value.
const _CRC32_TABLE: Array[Int] = [
  0x00000000, 0x77073096, 0xEE0E612C, 0x990951BA, 0x076DC419, 0x706AF48F, 0xE963A535, 0x9E6495A3,
  0x0EDB8832, 0x79DCB8A4, 0xE0D5E91E, 0x97D2D988, 0x09B64C2B, 0x7EB17CBD, 0xE7B82D07, 0x90BF1D91,
  0x1DB71064, 0x6AB020F2, 0xF3B97148, 0x84BE41DE, 0x1ADAD47D, 0x6DDDE4EB, 0xF4D4B551, 0x83D385C7,
  0x136C9856, 0x646BA8C0, 0xFD62F97A, 0x8A65C9EC, 0x14015C4F, 0x63066CD9, 0xFA0F3D63, 0x8D080DF5,
  0x3B6E20C8, 0x4C69105E, 0xD56041E4, 0xA2677172, 0x3C03E4D1, 0x4B04D447, 0xD20D85FD, 0xA50AB56B,
  0x35B5A8FA, 0x42B2986C, 0xDBBBC9D6, 0xACBCF940, 0x32D86CE3, 0x45DF5C75, 0xDCD60DCF, 0xABD13D59,
  0x26D930AC, 0x51DE003A, 0xC8D75180, 0xBFD06116, 0x21B4F4B5, 0x56B3C423, 0xCFBA9599, 0xB8BDA50F,
  0x2802B89E, 0x5F058808, 0xC60CD9B2, 0xB10BE924, 0x2F6F7C87, 0x58684C11, 0xC1611DAB, 0xB6662D3D,
  0x76DC4190, 0x01DB7106, 0x98D220BC, 0xEFD5102A, 0x71B18589, 0x06B6B51F, 0x9FBFE4A5, 0xE8B8D433,
  0x7807C9A2, 0x0F00F934, 0x9609A88E, 0xE10E9818, 0x7F6A0DBB, 0x086D3D2D, 0x91646C97, 0xE6635C01,
  0x6B6B51F4, 0x1C6C6162, 0x856530D8, 0xF262004E, 0x6C0695ED, 0x1B01A57B, 0x8208F4C1, 0xF50FC457,
  0x65B0D9C6, 0x12B7E950, 0x8BBEB8EA, 0xFCB9887C, 0x62DD1DDF, 0x15DA2D49, 0x8CD37CF3, 0xFBD44C65,
  0x4DB26158, 0x3AB551CE, 0xA3BC0074, 0xD4BB30E2, 0x4ADFA541, 0x3DD895D7, 0xA4D1C46D, 0xD3D6F4FB,
  0x4369E96A, 0x346ED9FC, 0xAD678846, 0xDA60B8D0, 0x44042D73, 0x33031DE5, 0xAA0A4C5F, 0xDD0D7CC9,
  0x5005713C, 0x270241AA, 0xBE0B1010, 0xC90C2086, 0x5768B525, 0x206F85B3, 0xB966D409, 0xCE61E49F,
  0x5EDEF90E, 0x29D9C998, 0xB0D09822, 0xC7D7A8B4, 0x59B33D17, 0x2EB40D81, 0xB7BD5C3B, 0xC0BA6CAD,
  0xEDB88320, 0x9ABFB3B6, 0x03B6E20C, 0x74B1D29A, 0xEAD54739, 0x9DD277AF, 0x04DB2615, 0x73DC1683,
  0xE3630B12, 0x94643B84, 0x0D6D6A3E, 0x7A6A5AA8, 0xE40ECF0B, 0x9309FF9D, 0x0A00AE27, 0x7D079EB1,
  0xF00F9344, 0x8708A3D2, 0x1E01F268, 0x6906C2FE, 0xF762575D, 0x806567CB, 0x196C3671, 0x6E6B06E7,
  0xFED41B76, 0x89D32BE0, 0x10DA7A5A, 0x67DD4ACC, 0xF9B9DF6F, 0x8EBEEFF9, 0x17B7BE43, 0x60B08ED5,
  0xD6D6A3E8, 0xA1D1937E, 0x38D8C2C4, 0x4FDFF252, 0xD1BB67F1, 0xA6BC5767, 0x3FB506DD, 0x48B2364B,
  0xD80D2BDA, 0xAF0A1B4C, 0x36034AF6, 0x41047A60, 0xDF60EFC3, 0xA867DF55, 0x316E8EEF, 0x4669BE79,
  0xCB61B38C, 0xBC66831A, 0x256FD2A0, 0x5268E236, 0xCC0C7795, 0xBB0B4703, 0x220216B9, 0x5505262F,
  0xC5BA3BBE, 0xB2BD0B28, 0x2BB45A92, 0x5CB36A04, 0xC2D7FFA7, 0xB5D0CF31, 0x2CD99E8B, 0x5BDEAE1D,
  0x9B64C2B0, 0xEC63F226, 0x756AA39C, 0x026D930A, 0x9C0906A9, 0xEB0E363F, 0x72076785, 0x05005713,
  0x95BF4A82, 0xE2B87A14, 0x7BB12BAE, 0x0CB61B38, 0x92D28E9B, 0xE5D5BE0D, 0x7CDCEFB7, 0x0BDBDF21,
  0x86D3D2D4, 0xF1D4E242, 0x68DDB3F8, 0x1FDA836E, 0x81BE16CD, 0xF6B9265B, 0x6FB077E1, 0x18B74777,
  0x88085AE6, 0xFF0F6A70, 0x66063BCA, 0x11010B5C, 0x8F659EFF, 0xF862AE69, 0x616BFFD3, 0x166CCF45,
  0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2, 0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB,
  0xAED16A4A, 0xD9D65ADC, 0x40DF0B66, 0x37D83BF0, 0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
  0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6, 0xBAD03605, 0xCDD70693, 0x54DE5729, 0x23D967BF,
  0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94, 0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D
]

// CRC-32 of a byte buffer. crc32(empty) == 0; crc32(toBytes("123456789")) == 3421780262 (0xCBF43926).
pub fn crc32(data: Bytes) -> Int {
  let mut crc = 0xFFFFFFFF
  for b in data { crc = (crc >> 8) ^ _CRC32_TABLE[(crc ^ b) & 0xFF] }
  (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

// CRC-32 of a String's bytes (a byte-level convenience over crc32).
pub fn crc32Str(s: String) -> Int { crc32(toBytes(s)) }

// --- MurmurHash3 (x86_32 variant) ---
//
// A fast NON-cryptographic hash (like crc32, not a secure digest): good avalanche/distribution for
// hash tables, bloom filters, and general fingerprinting. The result is a NON-NEGATIVE 32-bit Int (0 .. 2^32-1).
//
// 32-BIT MODULAR MULTIPLY IN A 48-BIT-SIGNED INT: unlike CRC/SHA-256 (which only add or xor 32-bit
// words), MurmurHash multiplies two FULL 32-bit values. The true product reaches ~2^64, which overflows
// not only the 48-bit Int but the int64 the VM's `*` computes in -- so `k * c1 & 0xFFFFFFFF` would rely
// on signed-overflow wraparound (UB-adjacent). Instead `_mul32` splits both operands into 16-bit halves
// so every partial product is a 16x16 = 32-bit value and every intermediate stays below 2^47: provably
// correct in the 48-bit model with no overflow anywhere. This is the one genuinely 48-bit-aware step;
// the rotations and xors are ordinary shift/mask (each intermediate < 2^32, so `>>` acts logical).

// (a * b) mod 2^32, computed via 16-bit half products so nothing exceeds 2^47 (no int64 overflow / no UB).
fn _mul32(a: Int, b: Int) -> Int {
  let aLo = a & 0xFFFF
  let aHi = (a >> 16) & 0xFFFF
  let bLo = b & 0xFFFF
  let bHi = (b >> 16) & 0xFFFF
  let lo = aLo * bLo                          // < 2^32
  let mid = (aLo * bHi + aHi * bLo) & 0xFFFF  // sum < 2^33; only its low 16 bits reach the result
  (lo + (mid << 16)) & 0xFFFFFFFF
}

// 32-bit left rotation. x is < 2^32 and r is 13 or 15 here, so x << r stays < 2^47 (no overflow); the
// final mask recovers the low 32 bits, and x >> (32-r) is a logical shift (x non-negative).
fn _rotl32(x: Int, r: Int) -> Int { ((x << r) | (x >> (32 - r))) & 0xFFFFFFFF }

// The MurmurHash3 finalization mix (avalanches the final hash).
fn _fmix32(h: Int) -> Int {
  let mut x = h ^ (h >> 16)
  x = _mul32(x, 0x85EBCA6B)
  x = x ^ (x >> 13)
  x = _mul32(x, 0xC2B2AE35)
  x ^ (x >> 16)
}

// MurmurHash3 x86_32 of a byte buffer with a 32-bit seed. murmur3(empty, 0) == 0.
pub fn murmur3(data: Bytes, seed: Int) -> Int {
  let c1 = 0xCC9E2D51
  let c2 = 0x1B873593
  let n = len(data)
  let nblocks = n / 4
  let mut h1 = seed & 0xFFFFFFFF

  // body -- one 4-byte little-endian block at a time
  let mut i = 0
  while i < nblocks {
    let base = i * 4
    let mut k = data[base] | (data[base + 1] << 8) | (data[base + 2] << 16) | (data[base + 3] << 24)
    k = _mul32(k, c1)
    k = _rotl32(k, 15)
    k = _mul32(k, c2)
    h1 = h1 ^ k
    h1 = _rotl32(h1, 13)
    h1 = (_mul32(h1, 5) + 0xE6546B64) & 0xFFFFFFFF
    i = i + 1
  }

  // tail -- the remaining n & 3 bytes (fall-through, big index first)
  let t = nblocks * 4
  let rem = n & 3
  let mut k = 0
  if rem == 3 { k = k ^ (data[t + 2] << 16) }
  if rem >= 2 { k = k ^ (data[t + 1] << 8) }
  if rem >= 1 {
    k = k ^ data[t]
    k = _mul32(k, c1)
    k = _rotl32(k, 15)
    k = _mul32(k, c2)
    h1 = h1 ^ k
  }

  // finalization
  h1 = h1 ^ n
  _fmix32(h1)
}

// MurmurHash3 x86_32 of a String's bytes with a 32-bit seed (a byte-level convenience over murmur3).
pub fn murmur3Str(s: String, seed: Int) -> Int { murmur3(toBytes(s), seed) }

// --- SHA-256 (FIPS 180-4) ---
//
// A CRYPTOGRAPHIC digest (unlike crc32). The 32-byte digest is computed by the native `sha256`
// (32-bit modular arithmetic is awkward in a 48-bit-Int language, so it lives in C++); the helpers
// below render it. KAT: sha256HexStr("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad".

// One lowercase hex digit for a nibble 0..15: 0-9 -> '0'..'9', 10-15 -> 'a'..'f'.
fn _hexDigit(n: Int) -> Int { if n < 10 { 48 + n } else { 87 + n } }

// Lowercase hex encoding of a byte buffer (2 chars per byte, no separators).
pub fn toHex(data: Bytes) -> String {
  let out = bytes()
  for b in data { push(out, _hexDigit((b >> 4) & 15))  push(out, _hexDigit(b & 15)) }
  fromBytes(out)
}

// The 32-byte SHA-256 digest of a String's bytes.
pub fn sha256Str(s: String) -> Bytes { sha256(toBytes(s)) }

// The SHA-256 digest as a 64-char lowercase hex string.
pub fn sha256Hex(data: Bytes) -> String { toHex(sha256(data)) }
pub fn sha256HexStr(s: String) -> String { toHex(sha256(toBytes(s))) }
