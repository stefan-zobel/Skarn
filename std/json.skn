// std::json -- a JSON (RFC 8259) parser + serializer in pure Skarn. OPT-IN: reach it via
// `use std::json::*` (or a qualified std::json::name). No native, no VM change; tree-shaken.
//
// Data model: a recursive enum. Objects are an ORDERED Vec[JsonEntry] (key order + duplicates
// preserved => deterministic, round-trippable serialization). Numbers split into Integer (48-bit)
// and Number (Double); an integer literal that overflows 48 bits falls back to Number.
// Internal helpers are `_j`-prefixed so `use std::json::*` only leaks the public surface.

pub enum Json { Null, Boolean(Bool), Integer(Int), Number(Double), Text(String), Arr(Vec[Json]), Obj(Vec[JsonEntry]) }
pub struct JsonEntry { key: String, val: Json }

// ---- cursor over the input bytes --------------------------------------------
// The cursor holds ONLY the materialized bytes. Slicing a token out via slice(s, ..) would
// re-run toBytes over the WHOLE document for every token -- quadratic on a number-heavy input.
// `depth` bounds array/object nesting: _jValue recurses, so without a cap a deeply nested input
// is a resource question rather than a parse error (RFC 8259 explicitly permits such a limit).
struct JsonCur { b: Bytes, n: Int, i: Int, depth: Int }
fn _jNew(s: String) -> JsonCur { let bs = toBytes(s)  JsonCur { b: bs, n: len(bs), i: 0, depth: 0 } }
// Maximum array/object nesting depth (matches std::regex's parser nesting cap).
fn _jMaxDepth() -> Int { 200 }
fn _jPeek(c: JsonCur) -> Int { if c.i < c.n { c.b[c.i] } else { 0 - 1 } }
fn _jAdv(mut c: JsonCur) -> () { c.i = c.i + 1 }
fn _jAtEnd(c: JsonCur) -> Bool { c.i >= c.n }
fn _jIsWs(b: Int) -> Bool { b == ' ' || b == '\t' || b == '\n' || b == '\r' }
fn _jSkipWs(mut c: JsonCur) -> () { while _jIsWs(_jPeek(c)) { _jAdv(c) } }
fn _jEat(mut c: JsonCur, ch: Int) -> Result[(), String] {
  if _jPeek(c) == ch { _jAdv(c) Ok(()) }
  else { Err("expected '" + charStr(ch) + "' at position " + toString(c.i)) }
}

// ---- values -----------------------------------------------------------------
fn _jValue(mut c: JsonCur) -> Result[Json, String] {
  _jSkipWs(c)
  let ch = _jPeek(c)
  if ch == '{' { _jObject(c) }
  else if ch == '[' { _jArray(c) }
  else if ch == '"' { let s = _jStrLit(c)?  Ok(Text(s)) }
  else if ch == 't' || ch == 'f' { _jBool(c) }
  else if ch == 'n' { _jLit(c, "null")?  Ok(Null) }
  else if ch == '-' || (ch >= '0' && ch <= '9') { _jNumber(c) }
  else { Err("unexpected character '" + charStr(ch) + "' at position " + toString(c.i)) }
}
fn _jBool(mut c: JsonCur) -> Result[Json, String] {
  if _jPeek(c) == 't' { _jLit(c, "true")?  Ok(Boolean(true)) }
  else { _jLit(c, "false")?  Ok(Boolean(false)) }
}
// Match a fixed keyword against the input, consuming it.
fn _jLit(mut c: JsonCur, kw: String) -> Result[(), String] {
  let kb = toBytes(kw)
  let m = len(kb)
  let mut k = 0
  while k < m {
    if _jPeek(c) != kb[k] { return Err("invalid literal at position " + toString(c.i)) }
    _jAdv(c)
    k = k + 1
  }
  Ok(())
}
fn _jIsNumByte(b: Int) -> Bool {
  (b >= '0' && b <= '9') || b == '-' || b == '+' || b == '.' || b == 'e' || b == 'E'
}
fn _jNumber(mut c: JsonCur) -> Result[Json, String] {
  let start = c.i
  let mut isReal = false
  while _jIsNumByte(_jPeek(c)) {
    let ch = _jPeek(c)
    if ch == '.' || ch == 'e' || ch == 'E' { isReal = true }
    _jAdv(c)
  }
  let text = sliceBytes(c.b, start, c.i)
  if isReal {
    match parseDouble(text) { Ok(d) => Ok(Number(d)), Err(e) => Err(e) }
  } else {
    // An integer that overflows the 48-bit range falls back to a Double.
    match parseInt(text) {
      Ok(n)  => Ok(Integer(n)),
      Err(_) => match parseDouble(text) { Ok(d) => Ok(Number(d)), Err(e) => Err(e) },
    }
  }
}

// ---- strings: decode escapes into a fresh byte buffer, then fromBytes --------
fn _jHexVal(ch: Int) -> Result[Int, String] {
  if      ch >= '0' && ch <= '9' { Ok(ch - '0') }
  else if ch >= 'a' && ch <= 'f' { Ok(ch - 'a' + 10) }
  else if ch >= 'A' && ch <= 'F' { Ok(ch - 'A' + 10) }
  else { Err("bad \\u hex digit") }
}
fn _jHex4(mut c: JsonCur) -> Result[Int, String] {
  let mut val = 0
  let mut k = 0
  while k < 4 {
    let h = _jHexVal(_jPeek(c))?
    val = val * 16 + h
    _jAdv(c)
    k = k + 1
  }
  Ok(val)
}
// Encode a Unicode code point into UTF-8 (1..4 bytes), pushing onto `buf`.
fn _jPushUtf8(mut buf: Bytes, cp: Int) -> () {
  if cp < 128 {
    push(buf, cp)
  } else if cp < 2048 {
    push(buf, 192 | (cp >> 6))
    push(buf, 128 | (cp & 63))
  } else if cp < 65536 {
    push(buf, 224 | (cp >> 12))
    push(buf, 128 | ((cp >> 6) & 63))
    push(buf, 128 | (cp & 63))
  } else {
    push(buf, 240 | (cp >> 18))
    push(buf, 128 | ((cp >> 12) & 63))
    push(buf, 128 | ((cp >> 6) & 63))
    push(buf, 128 | (cp & 63))
  }
}
// Read one \uXXXX (the leading \u already consumed); if it is a HIGH surrogate (0xD800..0xDBFF)
// pair it with a following \uYYYY LOW surrogate (0xDC00..0xDFFF) into an astral code point.
fn _jUnicode(mut c: JsonCur) -> Result[Int, String] {
  let hi = _jHex4(c)?
  if hi >= 55296 && hi <= 56319 {              // high surrogate
    if _jPeek(c) != '\\' { return Err("expected low surrogate at position " + toString(c.i)) }
    _jAdv(c)
    if _jPeek(c) != 'u' { return Err("expected low surrogate at position " + toString(c.i)) }
    _jAdv(c)
    let lo = _jHex4(c)?
    if lo < 56320 || lo > 57343 { return Err("invalid low surrogate at position " + toString(c.i)) }
    Ok(65536 + ((hi - 55296) << 10) + (lo - 56320))
  } else if hi >= 56320 && hi <= 57343 {       // lone low surrogate
    Err("unexpected low surrogate at position " + toString(c.i))
  } else {
    Ok(hi)
  }
}
fn _jStrLit(mut c: JsonCur) -> Result[String, String] {
  _jEat(c, '"')?
  let mut buf = bytes()
  loop {
    if _jAtEnd(c) { return Err("unterminated string at position " + toString(c.i)) }
    let ch = _jPeek(c)
    _jAdv(c)
    if ch == '"' {
      break
    } else if ch == '\\' {
      let e = _jPeek(c)
      _jAdv(c)
      if      e == '"'  { push(buf, '"') }
      else if e == '\\' { push(buf, '\\') }
      else if e == '/'  { push(buf, '/') }
      else if e == 'n'  { push(buf, '\n') }
      else if e == 't'  { push(buf, '\t') }
      else if e == 'r'  { push(buf, '\r') }
      else if e == 'b'  { push(buf, 8) }
      else if e == 'f'  { push(buf, 12) }
      else if e == 'u'  { let cp = _jUnicode(c)?  _jPushUtf8(buf, cp) }
      else { return Err("invalid escape at position " + toString(c.i)) }
    } else {
      push(buf, ch)
    }
  }
  Ok(fromBytes(buf))
}

// ---- arrays / objects (recursive) -------------------------------------------
fn _jArray(mut c: JsonCur) -> Result[Json, String] {
  _jEat(c, '[')?
  c.depth = c.depth + 1
  if c.depth > _jMaxDepth() { return Err("nesting too deep at position " + toString(c.i)) }
  let mut items: Vec[Json] = vec()
  _jSkipWs(c)
  if _jPeek(c) == ']' { _jAdv(c)  c.depth = c.depth - 1  return Ok(Arr(items)) }
  loop {
    let v = _jValue(c)?
    push(items, v)
    _jSkipWs(c)
    let ch = _jPeek(c)
    if ch == ',' { _jAdv(c) }
    else if ch == ']' { _jAdv(c)  break }
    else { return Err("expected ',' or ']' at position " + toString(c.i)) }
  }
  c.depth = c.depth - 1
  Ok(Arr(items))
}
fn _jObject(mut c: JsonCur) -> Result[Json, String] {
  _jEat(c, '{')?
  c.depth = c.depth + 1
  if c.depth > _jMaxDepth() { return Err("nesting too deep at position " + toString(c.i)) }
  let mut entries: Vec[JsonEntry] = vec()
  _jSkipWs(c)
  if _jPeek(c) == '}' { _jAdv(c)  c.depth = c.depth - 1  return Ok(Obj(entries)) }
  loop {
    _jSkipWs(c)
    if _jPeek(c) != '"' { return Err("expected string key at position " + toString(c.i)) }
    let key = _jStrLit(c)?
    _jSkipWs(c)
    _jEat(c, ':')?
    let val = _jValue(c)?
    push(entries, JsonEntry { key: key, val: val })
    _jSkipWs(c)
    let ch = _jPeek(c)
    if ch == ',' { _jAdv(c) }
    else if ch == '}' { _jAdv(c)  break }
    else { return Err("expected ',' or '}' at position " + toString(c.i)) }
  }
  c.depth = c.depth - 1
  Ok(Obj(entries))
}

// ============================================================================
// Serialization -- all three forms thread ONE StringBuilder (O(n) via BYTES_APPEND),
// with a single `build` at the end.
// ============================================================================

// A Double is finite iff d - d == 0.0 (finite -> 0.0; +-Inf -> Inf-Inf = NaN != 0; NaN -> NaN != 0).
// Self-contained -- avoids a std::math dependency for the NaN/Inf check.
fn _finite(d: Double) -> Bool { d - d == 0.0 }

fn _hexNib(n: Int) -> Int { if n < 10 { '0' + n } else { 'a' + (n - 10) } }

// Append `s` as a quoted, escaped JSON string. Mandatory escapes only; non-ASCII UTF-8
// bytes pass through unchanged (valid JSON). Iterates the string's raw BYTES.
fn _jStr(mut sb: StringBuilder, s: String) -> StringBuilder {
  sb.appendByte('"')
  for c in s {
    if      c == '"'  { sb.appendByte('\\')  sb.appendByte('"') }
    else if c == '\\' { sb.appendByte('\\')  sb.appendByte('\\') }
    else if c == '\n' { sb.appendByte('\\')  sb.appendByte('n') }
    else if c == '\r' { sb.appendByte('\\')  sb.appendByte('r') }
    else if c == '\t' { sb.appendByte('\\')  sb.appendByte('t') }
    else if c == 8    { sb.appendByte('\\')  sb.appendByte('b') }
    else if c == 12   { sb.appendByte('\\')  sb.appendByte('f') }
    else if c < 32    {
      sb.appendByte('\\')  sb.appendByte('u')  sb.appendByte('0')  sb.appendByte('0')
      sb.appendByte(_hexNib((c >> 4) & 15))  sb.appendByte(_hexNib(c & 15))
    }
    else { sb.appendByte(c) }
  }
  sb.appendByte('"')
}

fn _jVal(mut sb: StringBuilder, j: Json) -> StringBuilder {
  match j {
    Null    => sb.append("null"),
    Boolean(b) => sb.append(if b { "true" } else { "false" }),
    Integer(n)  => sb.append(toString(n)),
    Number(d)  => if _finite(d) { sb.append(toString(d)) } else { sb.append("null") },
    Text(s)  => _jStr(sb, s),
    Arr(xs) => _jArr(sb, xs),
    Obj(es) => _jObj(sb, es),
  }
}
fn _jArr(mut sb: StringBuilder, xs: Vec[Json]) -> StringBuilder {
  sb.appendByte('[')
  let mut first = true
  for x in xs {
    if !first { sb.appendByte(',') }
    _jVal(sb, x)
    first = false
  }
  sb.appendByte(']')
}
fn _jObj(mut sb: StringBuilder, es: Vec[JsonEntry]) -> StringBuilder {
  sb.appendByte('{')
  let mut first = true
  for e in es {
    if !first { sb.appendByte(',') }
    _jStr(sb, e.key)
    sb.appendByte(':')
    _jVal(sb, e.val)
    first = false
  }
  sb.appendByte('}')
}

// stringify / stringifyChecked / stringifyPretty are inherent methods on Json (see `impl Json` at the
// end of this file); the private `_j*` walkers they drive stay free functions here.

// The non-finite scan behind stringifyChecked: true iff the tree contains a non-finite number (NaN/Inf),
// which has no valid JSON form.
fn _anyNonFinite(j: Json) -> Bool {
  match j {
    Number(d)  => !_finite(d),
    Arr(xs) => _anyNonFiniteArr(xs),
    Obj(es) => _anyNonFiniteObj(es),
    _ => false,
  }
}
fn _anyNonFiniteArr(xs: Vec[Json]) -> Bool {
  let n = len(xs)
  let mut i = 0
  while i < n { if _anyNonFinite(xs[i]) { return true }  i = i + 1 }
  false
}
fn _anyNonFiniteObj(es: Vec[JsonEntry]) -> Bool {
  let n = len(es)
  let mut i = 0
  while i < n { if _anyNonFinite(es[i].val) { return true }  i = i + 1 }
  false
}

// stringifyPretty(j, indent) -> multi-line JSON, `indent` spaces per nesting level. Empty
// arrays/objects stay inline as [] / {}.
fn _jIndent(mut sb: StringBuilder, depth: Int, indent: Int) -> () {
  sb.appendByte('\n')
  let total = depth * indent
  let mut k = 0
  while k < total { sb.appendByte(' ')  k = k + 1 }
}
fn _jPretty(mut sb: StringBuilder, j: Json, depth: Int, indent: Int) -> StringBuilder {
  match j {
    Arr(xs) => _jArrPretty(sb, xs, depth, indent),
    Obj(es) => _jObjPretty(sb, es, depth, indent),
    _ => _jVal(sb, j),
  }
}
fn _jArrPretty(mut sb: StringBuilder, xs: Vec[Json], depth: Int, indent: Int) -> StringBuilder {
  if len(xs) == 0 { sb.append("[]") }
  else {
    sb.appendByte('[')
    let mut first = true
    for x in xs {
      if !first { sb.appendByte(',') }
      _jIndent(sb, depth + 1, indent)
      _jPretty(sb, x, depth + 1, indent)
      first = false
    }
    _jIndent(sb, depth, indent)
    sb.appendByte(']')
  }
}
fn _jObjPretty(mut sb: StringBuilder, es: Vec[JsonEntry], depth: Int, indent: Int) -> StringBuilder {
  if len(es) == 0 { sb.append("{}") }
  else {
    sb.appendByte('{')
    let mut first = true
    for e in es {
      if !first { sb.appendByte(',') }
      _jIndent(sb, depth + 1, indent)
      _jStr(sb, e.key)
      sb.append(": ")
      _jPretty(sb, e.val, depth + 1, indent)
      first = false
    }
    _jIndent(sb, depth, indent)
    sb.appendByte('}')
  }
}
// --- private accessor helpers (drive the methods in `impl Json` below) ---

// getField's linear scan: the value of the FIRST entry matching `key`.
fn _jFind(es: Vec[JsonEntry], key: String, i: Int) -> Option[Json] {
  if i >= len(es) { None }
  else { let e = es[i]  if e.key == key { Some(e.val) } else { _jFind(es, key, i + 1) } }
}
// asMap accumulator (later duplicate keys overwrite earlier ones).
fn _jAsMap(es: Vec[JsonEntry], i: Int, mut m: Map[String, Json]) -> Map[String, Json] {
  if i >= len(es) { m }
  else { let e = es[i]  m[e.key] = e.val  _jAsMap(es, i + 1, m) }
}

// ============================================================================
// Json's own API -- serialization + typed accessors, called with dot syntax:
// `j.stringify()`, `j.stringifyPretty(2)`, `j.asInt()`, `j.getField(k)`, `j.at(i)`, ...
// The accessors return Option (None on a kind mismatch / miss); asMap is named so
// (not toMap) to avoid the std::iter::toMap Iterator terminal.
// ============================================================================
impl Json {
  // --- parsing (an ASSOCIATED function: no `self`, so `Json::parse(s)` only) ---
  // Ok(Json) | Err(message-with-position). Full value grammar; strings decode all escapes incl.
  // \uXXXX surrogate pairs; trailing non-whitespace is an error. Namespacing it here is what lets
  // it be called `parse` at all -- as a free fn the bare name was claimed for every importer.
  fn parse(s: String) -> Result[Json, String] {
    let mut c = _jNew(s)
    let v = _jValue(c)?
    _jSkipWs(c)
    if !_jAtEnd(c) { return Err("trailing characters at position " + toString(c.i)) }
    Ok(v)
  }

  // --- serialization (drives the private _j* walkers above) ---
  // Compact JSON. A non-finite Number (NaN/Inf) is emitted as `null`.
  fn stringify(self) -> String { _jVal(stringBuilder(), self).build() }
  // Err when the tree contains a non-finite number (no valid JSON form); else same as stringify.
  fn stringifyChecked(self) -> Result[String, String] {
    if _anyNonFinite(self) { Err("cannot serialize a non-finite number") }
    else { Ok(self.stringify()) }
  }
  // Multi-line JSON, `indent` spaces per nesting level. Empty arrays/objects stay inline as [] / {}.
  fn stringifyPretty(self, indent: Int) -> String { _jPretty(stringBuilder(), self, 0, indent).build() }

  // --- typed accessors ---
  fn isNull(self) -> Bool { match self { Null => true, _ => false } }
  fn asInt(self) -> Option[Int] { match self { Integer(n) => Some(n), _ => None } }
  // asDouble widens an Integer to Double (via the Int<:Double boundary); + 0.0 forces the promotion.
  fn asDouble(self) -> Option[Double] { match self { Integer(n) => Some(n + 0.0), Number(d) => Some(d), _ => None } }
  fn asStr(self) -> Option[String] { match self { Text(s) => Some(s), _ => None } }
  fn asBool(self) -> Option[Bool] { match self { Boolean(b) => Some(b), _ => None } }
  fn asArr(self) -> Option[Vec[Json]] { match self { Arr(xs) => Some(xs), _ => None } }
  fn asObj(self) -> Option[Vec[JsonEntry]] { match self { Obj(es) => Some(es), _ => None } }

  // The value of the FIRST entry matching `key` (None if not an object / absent).
  fn getField(self, key: String) -> Option[Json] {
    match self { Obj(es) => _jFind(es, key, 0), _ => None }
  }
  // The i-th array element (None if not an array / out of bounds).
  fn at(self, i: Int) -> Option[Json] {
    match self { Arr(xs) => if i >= 0 && i < len(xs) { Some(xs[i]) } else { None }, _ => None }
  }
  // A Map of the object's entries.
  fn asMap(self) -> Option[Map[String, Json]] {
    match self { Obj(es) => Some(_jAsMap(es, 0, #{})), _ => None }
  }
}
