*.skn linguist-language=Rust

# Normalize all text files to LF in the repo, but use CRLF on Windows checkout
* text=auto

# Explicitly ensure .cpp, .h and .cs files always use CRLF locally
*.h text eol=crlf
*.cpp text eol=crlf

*.html linguist-documentation
*.js linguist-documentation
*.css linguist-documentation
*.ts linguist-documentation
*.mjs linguist-documentation
*.mts linguist-documentation
*.cts linguist-documentation
*.map linguist-documentation
