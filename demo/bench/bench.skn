// bench.skn -- a tiny per-op microbenchmark for the Skarn VM (run with skarnvm).
//
//   skarnvm demo/bench/bench.skn
//
// Each workload times its own hot region with nanoTime() and prints the wall time plus the
// per-unit cost (ns/iter, ns/call, ns/elem). To turn a per-unit figure into ns-per-BYTECODE-OP,
// divide by the measured ops-per-unit noted beside each workload -- those op counts came from a
// throwaway build of the VM with the dispatch loop instrumented to count ops (`-DVM_COUNT_OPS`,
// which prints `[VM_OPS] N` at HALT; the shipping VM has no such counter). Because the op count is
// deterministic, ns/op = (untampered wall from this run) / (op count from the counting build).
//
// ---------------------------------------------------------------------------------------------
// CROSS-LANGUAGE. The CPython side is `demo/bench/bench.py` (`python demo/bench/bench.py`), which
// runs the same three workloads at the same sizes. It writes workloads 1 and 3 twice: once as the
// literal translation of this file, once the way a Python programmer would write them.
//
// A SINGLE "Skarn vs Python" RATIO DOES NOT EXIST. The idiomatic Python forms move the loop into C,
// so the result depends on which of the two comparisons is made -- any quotable number has to name
// it. On interpreted work the comparison is interpreter against interpreter: an Int here is a
// NaN-boxed immediate in a register window, against a refcounted PyObject* on a stack machine. On
// the lazy pipeline the whole Skarn stream is interpreted (per element: a trait dispatch, a frame
// setup, an Option), while CPython's generator machinery is not.
//
// Workload 1 note: Skarn's Int is 48-bit and WRAPS, so its checksum differs from CPython's exact
// value. Same work per iteration, different result -- worth knowing, not a fairness problem.
// ---------------------------------------------------------------------------------------------
//
// The sizes below take ~15 s total; shrink n / k for a quicker run.
use std::env::*

// --- 1. compute-bound: a tight integer loop.  3 bytecode ops / iteration ---
// (ADD_INT, INCR, BLT_INT.)
let n1 = 200000000
let t0 = nanoTime()
let mut s = 0
let mut i = 0
while i < n1 {
  s = s + i
  i = i + 1
}
let e0 = nanoTime() - t0
println("arith  n=" + toString(n1) + "  checksum=" + toString(s)
        + "  wall_ns=" + toString(e0) + "  ns/iter=" + toString(e0 / n1))

// --- 2. call-bound: naive recursive Fibonacci.  ~8.5 bytecode ops / call ---
fn fib(k: Int) -> Int { if k < 2 { k } else { fib(k - 1) + fib(k - 2) } }
let k = 36
let t1 = nanoTime()
let r = fib(k)
let e1 = nanoTime() - t1
println("fib    k=" + toString(k) + "  fib=" + toString(r) + "  wall_ns=" + toString(e1))

// --- 3. lazy-pipeline (dispatch + alloc-heavy): filter -> map -> fold.  ~56.5 bytecode ops / elem ---
let n3 = 5000000
let t2 = nanoTime()
let total = fold(map(filter(range(0, n3), fn(x: Int) -> Bool { x % 2 == 0 }),
                     fn(x: Int) -> Int { x + 1 }),
                 0, fn(a: Int, b: Int) -> Int { a + b })
let e2 = nanoTime() - t2
println("iter   n=" + toString(n3) + "  total=" + toString(total)
        + "  wall_ns=" + toString(e2) + "  ns/elem=" + toString(e2 / n3))
