// A ray: a point of origin and a direction. Everything the renderer does is asking
// "what does this ray hit, and what colour comes back".
//
// The direction is deliberately NOT required to be a unit vector. Normalizing here would
// cost a sqrt per ray for no benefit: the sphere intersection is written against
// dir.lengthSquared(), so it is scale-invariant, and the one place that does need a unit
// direction (the background gradient) normalizes explicitly.

import vec3
use vec3::*

pub struct Ray { origin: Vec3, dir: Vec3 }

pub fn ray(origin: Vec3, dir: Vec3) -> Ray { Ray { origin: origin, dir: dir } }

impl Ray {
    // The point reached after travelling `t` along the ray. `t` is the parameter every
    // intersection routine returns, so this is how a hit becomes a position.
    fn at(self, t: Double) -> Vec3 { self.origin.add(self.dir.scale(t)) }
}
