// A raytracer in Skarn: materials, recursive bouncing, antialiasing.
//
// The image is formed the way a real path tracer forms one: a ray that hits a surface
// is SCATTERED by that surface's material and traced onwards, and what comes back is
// filtered through the surface's colour. Repeat until the ray escapes to the sky or the
// bounce budget runs out. Several jittered rays per pixel average away the staircase edges.
//
// The self-tests run before every render (unless --quiet). They are the reason a wrong picture
// can be blamed on one thing at a time: geometry and the file format each have their own layer,
// and so do scattering and the reproducibility of the random stream.
//
// Everything here is DETERMINISTIC: one seed, and from it one random stream PER ROW, so the same
// source produces the same file byte for byte -- whether it renders on one thread or on many
// (--threads=N). That is what makes the renderer its own regression test.
//
// Run:  static_vmrun demo/raytracer/main.skn

import vec3
import bmp
import ray
import material
import hittable
import camera

use vec3::*
use bmp::*
use ray::*
use material::*
use hittable::*
use camera::*
use std::io::*
use std::math::*
use std::env::*
use std::random::*
use std::cli::*
use std::hash::*
use std::task::*

// Far enough to be "no limit" for a scene measured in single units.
const T_MAX: Double = 1000000000.0

// The image. WIDTH is deliberately not a multiple of 4, so the written rows carry a
// 2-byte pad and the padding path is exercised at full size.
const WIDTH:     Int = 470
const HEIGHT:    Int = 264
// 16 samples is not a taste decision: 470*264*16 = 1.99 M primary rays keeps a full render
// at around a minute. Noise falls as 1/sqrt(SAMPLES), so doubling it buys a 1.4x cleaner image for
// twice the wall time.
const SAMPLES:   Int = 16     // jittered rays per pixel
const MAX_DEPTH: Int = 12     // bounce budget; beyond ~10 the contribution is invisible
const SEED:      Int = 20260728

// The renderer is DETERMINISTIC: one seed, and row y draws from its own stream seeded with
// SEED + y, whichever task renders it. A given configuration therefore produces one exact
// file for ANY number of tasks, and pinning its CRC-32 turns the raytracer into its own
// regression test -- a change that moves a single pixel fails here instead of passing quietly.
// It also checks the three intersection kernels against each other for free, and the parallel
// render against the sequential one, since all must reach the same number.
//
// Re-pin these ONLY together with a deliberate change to the image, and say why. Last re-pin:
// one random stream per row instead of one for the whole image, which parallel rendering needs
// (with a single stream, row y depended on every draw made before it).
const CRC_PREVIEW: Int = 3886897764     // 160x90,  4 samples, depth 12, seed above
const CRC_FULL:    Int = 3340800133    // 470x264, 16 samples, depth 12, seed above

// ---------------------------------------------------------------- test helpers

fn close(a: Double, b: Double) -> Bool { abs(a - b) < 0.000001 }

// Componentwise, with a tolerance. Needed wherever a transcendental function is involved:
// the camera's viewport comes out of tan(45 degrees), which is 0.9999999999999999, not 1.0,
// so its corners must be compared with an epsilon and not by their rendered text.
fn closeV(a: Vec3, b: Vec3) -> Bool { close(a.x, b.x) && close(a.y, b.y) && close(a.z, b.z) }

fn expect(label: String, ok: Bool) -> Bool {
    if ok { println("  ok    ${label}") } else { println("  FAIL  ${label}") }
    ok
}

fn u32At(b: Bytes, i: Int) -> Int { b[i] | (b[i + 1] << 8) | (b[i + 2] << 16) | (b[i + 3] << 24) }
fn u16At(b: Bytes, i: Int) -> Int { b[i] | (b[i + 1] << 8) }

// A stand-in material for the geometry tests, which care about `t` and normals only.
fn testMat() -> dyn Material { lambertian(vec3(0.5, 0.5, 0.5)) }

// ---------------------------------------------------------------- 1. Vec3

fn vecSelfTest() -> Bool {
    println("Vec3:")
    let a = vec3(1.0, 2.0, 3.0)
    let b = vec3(0.5, -1.0, 2.0)
    let mut ok = true

    ok = expect("add            ", a.add(b).fmt() == "(1.5, 1.0, 5.0)") && ok
    ok = expect("sub            ", a.sub(b).fmt() == "(0.5, 3.0, 1.0)") && ok
    ok = expect("scale          ", a.scale(2.0).fmt() == "(2.0, 4.0, 6.0)") && ok
    ok = expect("neg            ", a.neg().fmt() == "(-1.0, -2.0, -3.0)") && ok
    ok = expect("mul (per-component)", a.mul(b).fmt() == "(0.5, -2.0, 6.0)") && ok
    ok = expect("dot            ", close(a.dot(b), 4.5)) && ok

    let ex = vec3(1.0, 0.0, 0.0)
    let ey = vec3(0.0, 1.0, 0.0)
    ok = expect("cross          ", ex.cross(ey).fmt() == "(0.0, 0.0, 1.0)") && ok

    ok = expect("length         ", close(vec3(3.0, 4.0, 0.0).length(), 5.0)) && ok
    ok = expect("unit is unit   ", close(vec3(3.0, 4.0, 12.0).unit().length(), 1.0)) && ok
    ok = expect("reflect        ", vec3(1.0, -1.0, 0.0).reflect(ey).fmt() == "(1.0, 1.0, 0.0)") && ok
    ok = expect("nearZero true  ", zero3().nearZero()) && ok
    ok = expect("nearZero false ", !a.nearZero()) && ok
    ok
}

// ---------------------------------------------------------------- 2. BMP encoder

fn bmpSelfTest() -> Bool {
    println("BMP encoder (3x2 image, worked out by hand):")
    let mut img = canvas(3, 2)
    img.set(0, 0,  10,  20,  30)
    img.set(2, 1, 200, 100,  50)
    let f = img.toBmp()
    let mut ok = true

    ok = expect("size 78 bytes  ", len(f) == 78 && img.bmpSize() == 78) && ok
    ok = expect("magic 'BM'     ", f[0] == 66 && f[1] == 77) && ok
    ok = expect("file size field", u32At(f, 2) == 78) && ok
    ok = expect("data offset 54 ", u32At(f, 10) == 54) && ok
    ok = expect("width 3        ", u32At(f, 18) == 3) && ok
    ok = expect("height 2       ", u32At(f, 22) == 2) && ok
    ok = expect("24 bpp         ", u16At(f, 28) == 24) && ok
    ok = expect("bottom row first, BGR order", f[60] == 50 && f[61] == 100 && f[62] == 200) && ok
    ok = expect("row padding is 3 zero bytes", f[63] == 0 && f[64] == 0 && f[65] == 0) && ok
    ok = expect("top row second ", f[66] == 30 && f[67] == 20 && f[68] == 10) && ok
    ok
}

// ---------------------------------------------------------------- 3. geometry

fn geometrySelfTest() -> Bool {
    println("Sphere intersection:")
    let s = sphere(vec3(0.0, 0.0, -1.0), 0.5, testMat())
    let down = vec3(0.0, 0.0, -1.0)
    let mut ok = true

    match s.hit(ray(zero3(), down), 0.001, T_MAX) {
        Some(h) => {
            ok = expect("frontal hit at t = 0.5 ", close(h.t, 0.5)) && ok
            ok = expect("hit point              ", h.p.fmt() == "(0.0, 0.0, -0.5)") && ok
            ok = expect("normal faces the ray   ", h.normal.fmt() == "(0.0, 0.0, 1.0)") && ok
            ok = expect("front face             ", h.frontFace) && ok
        },
        None => { ok = expect("frontal hit            ", false) && ok },
    }

    ok = expect("miss returns None      ",
                match s.hit(ray(zero3(), vec3(0.0, 1.0, 0.0)), 0.001, T_MAX) { Some(_) => false, None => true }) && ok
    ok = expect("hit behind is rejected ",
                match s.hit(ray(zero3(), vec3(0.0, 0.0, 1.0)), 0.001, T_MAX) { Some(_) => false, None => true }) && ok

    match s.hit(ray(vec3(0.0, 0.0, -1.0), down), 0.001, T_MAX) {
        Some(h) => {
            ok = expect("from inside takes far root", close(h.t, 0.5)) && ok
            ok = expect("back face is recorded  ", !h.frontFace) && ok
        },
        None => { ok = expect("hit from inside        ", false) && ok },
    }

    let mut world: Vec[dyn Hittable] = vec()
    push(world, sphere(vec3(0.0, 0.0, -5.0), 0.5, testMat()))
    push(world, sphere(vec3(0.0, 0.0, -1.0), 0.5, testMat()))
    ok = expect("scene returns the NEAREST hit",
                match hitScene(world, ray(zero3(), down), 0.001, T_MAX) {
                    Some(h) => close(h.t, 0.5),
                    None    => false,
                }) && ok
    ok
}

// ---------------------------------------------------------------- 4. camera

fn cameraSelfTest() -> Bool {
    println("Camera (90 degree vfov, aspect 2):")
    let cam = camera(zero3(), vec3(0.0, 0.0, -1.0), vec3(0.0, 1.0, 0.0), 90.0, 2.0)
    let mut ok = true

    ok = expect("centre ray points forward", closeV(cam.rayAt(0.5, 0.5).dir, vec3(0.0, 0.0, -1.0))) && ok
    ok = expect("bottom-left corner       ", closeV(cam.rayAt(0.0, 0.0).dir, vec3(-2.0, -1.0, -1.0))) && ok
    ok = expect("top-right corner         ", closeV(cam.rayAt(1.0, 1.0).dir, vec3(2.0, 1.0, -1.0))) && ok
    ok = expect("origin is the eye        ", closeV(cam.rayAt(0.3, 0.7).origin, zero3())) && ok

    let narrow = camera(zero3(), vec3(0.0, 0.0, -1.0), vec3(0.0, 1.0, 0.0), 45.0, 2.0)
    ok = expect("narrower vfov sees less  ",
                narrow.rayAt(1.0, 1.0).dir.x < cam.rayAt(1.0, 1.0).dir.x) && ok
    ok
}

// ---------------------------------------------------------------- 5. materials

fn materialSelfTest() -> Bool {
    println("Materials and the random stream:")
    let mut rng = Rng::fromSeed(99)
    let up = vec3(0.0, 1.0, 0.0)
    let mut ok = true

    // A random direction from the unit sphere really is a unit vector, and really does
    // move: a generator threaded by value instead of by reference would repeat forever.
    let d1 = randomUnitVector(rng)
    let d2 = randomUnitVector(rng)
    ok = expect("random direction is unit ", close(d1.length(), 1.0) && close(d2.length(), 1.0)) && ok
    ok = expect("mut rng advances the caller's stream", !closeV(d1, d2)) && ok
    ok = expect("point stays inside the ball", randomInUnitSphere(rng).lengthSquared() < 1.0) && ok

    // Matte: always scatters, always into the upper hemisphere, and hands back its albedo.
    let lam = lambertian(vec3(0.2, 0.4, 0.6))
    match lam.scatter(ray(zero3(), vec3(0.0, -1.0, 0.0)), zero3(), up, rng) {
        Some(s) => {
            ok = expect("matte scatters           ", closeV(s.attenuation, vec3(0.2, 0.4, 0.6))) && ok
            ok = expect("matte scatters outwards  ", s.ray.dir.dot(up) > 0.0) && ok
        },
        None => { ok = expect("matte scatters           ", false) && ok },
    }

    // A perfect mirror: 45 degrees in, 45 degrees out, and the ray leaves from the hit point.
    let mir = metal(vec3(0.9, 0.9, 0.9), 0.0)
    match mir.scatter(ray(vec3(-1.0, 1.0, 0.0), vec3(1.0, -1.0, 0.0)), zero3(), up, rng) {
        Some(s) => {
            ok = expect("mirror reflects at 45 deg", closeV(s.ray.dir.unit(), vec3(1.0, 1.0, 0.0).unit())) && ok
            ok = expect("mirror ray starts at hit ", closeV(s.ray.origin, zero3())) && ok
        },
        None => { ok = expect("mirror reflects          ", false) && ok },
    }

    // Grazing a fully fuzzed mirror can scatter INTO the surface, which must be absorbed
    // rather than traced onwards -- otherwise the ray is trapped inside the solid.
    let rough = metal(vec3(0.9, 0.9, 0.9), 1.0)
    let mut absorbed = 0
    let mut i = 0
    while i < 200 {
        match rough.scatter(ray(vec3(-1.0, 0.02, 0.0), vec3(1.0, -0.02, 0.0)), zero3(), up, rng) {
            Some(_) => {},
            None    => { absorbed = absorbed + 1 },
        }
        i = i + 1
    }
    ok = expect("fuzzed grazing rays get absorbed", absorbed > 0) && ok

    // The whole point of a seeded generator: the same seed replays the same stream.
    let mut ra = Rng::fromSeed(4711)
    let mut rb = Rng::fromSeed(4711)
    ok = expect("same seed, same stream   ", closeV(randomUnitVector(ra), randomUnitVector(rb))) && ok
    ok
}

// ---------------------------------------------------------------- rendering

// 0.0 .. 1.0 -> 0 .. 255, through a gamma-2 transfer. Light adds up linearly, but a display
// does not show it linearly: without the sqrt every matte surface comes out far too dark.
fn toByteGamma(v: Double) -> Int { toInt(255.999 * sqrt(clamp(v, 0.0, 1.0))) }

// What colour comes back along this ray. A hit asks the surface's material where the ray
// goes next, traces THAT, and filters the answer through the surface colour -- so the
// recursion depth is the number of bounces of light being simulated. A ray that hits
// nothing gets the sky.
//
// `depth` bounds the recursion, and it must: two facing mirrors would otherwise trace
// forever. Returning black at the limit is the standard choice -- it under-reports light
// very slightly, invisibly so beyond a handful of bounces.
//
// tMin is 0.001, not 0: a scattered ray starts ON the surface it left, and floating-point
// error would otherwise let it immediately re-hit that surface at t ~ 1e-8. That is the
// classic "shadow acne", and the interval is what prevents it.
fn rayColor(r: Ray, world: Vec[dyn Hittable], depth: Int, mut rng: Rng) -> Vec3 {
    if depth <= 0 { return zero3() }
    match hitScene(world, r, 0.001, T_MAX) {
        Some(h) => match h.mat.scatter(r, h.p, h.normal, rng) {
            Some(s) => s.attenuation.mul(rayColor(s.ray, world, depth - 1, rng)),
            None    => zero3(),          // absorbed
        },
        None => {
            let t = 0.5 * (r.dir.unit().y + 1.0)
            vec3(1.0, 1.0, 1.0).scale(1.0 - t).add(vec3(0.5, 0.7, 1.0).scale(t))
        },
    }
}

// The camera for an image of this size: at the origin, looking down -z, a 90 degree field of view.
fn makeCamera(width: Int, height: Int) -> Camera {
    camera(zero3(), vec3(0.0, 0.0, -1.0), vec3(0.0, 1.0, 0.0), 90.0,
           toDouble(width) / toDouble(height))
}

// One unit of rendering work: every `step`-th row of the image, starting at row `first`.
// `step` is 1 for the whole image in one go; with N tasks, task k takes rows k, k+N, k+2N, ...
// The rows are INTERLEAVED rather than cut into N bands because they are far from equal work:
// the top rows are mostly sky, one miss per ray, while the ground rows bounce up to MAX_DEPTH
// times. Bands would leave the top tasks idle while the bottom ones still run.
//
// It is plain data -- a task's argument is copied to its own heap -- which is also why the
// task builds the scene and the camera itself: the scene holds `dyn` values, and those cannot
// be sent. Four spheres cost nothing to build.
struct RowJob { first: Int, step: Int, width: Int, height: Int, samples: Int, kernel: Int }

// Render the job's rows, packed 0xRRGGBB, row after row. EVERY ROW HAS ITS OWN RANDOM STREAM,
// seeded from its index: that is what makes a row's pixels independent of which task renders
// it, and of which rows were rendered before it -- so the image, and its checksum, are the same
// for any number of tasks.
fn renderRows(job: RowJob) -> Array[Int] {
    let world = buildScene(job.kernel)
    let cam   = makeCamera(job.width, job.height)
    let rows  = (job.height - job.first + job.step - 1) / job.step
    let mut out = array(rows * job.width, 0)
    let mut i = 0
    let mut y = job.first
    while y < job.height {
        let mut rng = Rng::fromSeed(SEED + y)
        let mut x = 0
        while x < job.width {
            // `samples` rays per pixel, each aimed at a random point WITHIN the pixel rather
            // than at its centre. Averaging them is what turns a hard staircase edge into a
            // smooth one -- the jitter is the whole mechanism, not a refinement of it.
            let mut acc = zero3()
            let mut s = 0
            while s < job.samples {
                let u = (toDouble(x) + rng.nextDouble()) / toDouble(job.width - 1)
                let v = 1.0 - (toDouble(y) + rng.nextDouble()) / toDouble(job.height - 1)
                acc = acc.add(rayColor(cam.rayAt(u, v), world, MAX_DEPTH, rng))
                s = s + 1
            }
            let c = acc.scale(1.0 / toDouble(job.samples))
            out[i] = ((toByteGamma(c.x) & 255) << 16) | ((toByteGamma(c.y) & 255) << 8) | (toByteGamma(c.z) & 255)
            i = i + 1
            x = x + 1
        }
        y = y + job.step
    }
    out
}

// Copy a job's rows into their places in the image.
fn place(mut img: Canvas, rows: Array[Int], first: Int, step: Int) -> () {
    let mut i = 0
    let mut y = first
    while y < img.height {
        let mut x = 0
        while x < img.width {
            img.px[y * img.width + x] = rows[i]
            i = i + 1
            x = x + 1
        }
        y = y + step
    }
}

// The whole image, on `threads` tasks. With one thread nothing is spawned: the same renderRows
// runs right here, which is the sequential baseline the parallel runs are measured against.
fn render(width: Int, height: Int, samples: Int, kernel: Int, threads: Int) -> Canvas {
    let mut img = canvas(width, height)
    if threads <= 1 {
        place(img, renderRows(RowJob { first: 0, step: 1, width: width, height: height,
                                       samples: samples, kernel: kernel }), 0, 1)
        return img
    }
    let mut tasks: Vec[Task[Array[Int]]] = vec()
    let mut k = 0
    while k < threads {
        push(tasks, spawn(renderRows, RowJob { first: k, step: threads, width: width, height: height,
                                               samples: samples, kernel: kernel }))
        k = k + 1
    }
    k = 0
    while k < threads {
        match tasks[k].join() {
            Ok(rows) => place(img, rows, k, threads),
            Err(e)   => panic("render task ${k} failed: ${e}"),
        }
        k = k + 1
    }
    img
}

// A matte sphere between two metal ones, all standing on a very large matte sphere that
// reads as ground. The left mirror is nearly perfect; the right one is heavily fuzzed.
//
// `kernel` picks the intersection routine: 0 = idiomatic, 1 = scalar-inlined by hand,
// 2 = compiler-style inlined (calls gone, objects kept). All three branches describe the
// SAME scene, so all three renders must agree byte for byte -- which is what makes the
// three timings a decomposition rather than three unrelated numbers. See hittable.skn.
fn buildScene(kernel: Int) -> Vec[dyn Hittable] {
    let ground = lambertian(vec3(0.8, 0.8, 0.0))
    let matte  = lambertian(vec3(0.1, 0.2, 0.5))
    let mirror = metal(vec3(0.8, 0.8, 0.8), 0.05)
    let gold   = metal(vec3(0.8, 0.6, 0.2), 0.40)
    let mut w: Vec[dyn Hittable] = vec()
    if kernel == 1 {
        push(w, fastSphere(vec3( 0.0, -100.5, -1.0), 100.0, ground))
        push(w, fastSphere(vec3( 0.0,    0.0, -1.0),   0.5, matte))
        push(w, fastSphere(vec3(-1.0,    0.0, -1.0),   0.5, mirror))
        push(w, fastSphere(vec3( 1.0,    0.0, -1.0),   0.5, gold))
    } else if kernel == 2 {
        push(w, inlinedSphere(vec3( 0.0, -100.5, -1.0), 100.0, ground))
        push(w, inlinedSphere(vec3( 0.0,    0.0, -1.0),   0.5, matte))
        push(w, inlinedSphere(vec3(-1.0,    0.0, -1.0),   0.5, mirror))
        push(w, inlinedSphere(vec3( 1.0,    0.0, -1.0),   0.5, gold))
    } else {
        push(w, sphere(vec3( 0.0, -100.5, -1.0), 100.0, ground))
        push(w, sphere(vec3( 0.0,    0.0, -1.0),   0.5, matte))
        push(w, sphere(vec3(-1.0,    0.0, -1.0),   0.5, mirror))
        push(w, sphere(vec3( 1.0,    0.0, -1.0),   0.5, gold))
    }
    w
}

// ---------------------------------------------------------------- driver

// Flags:
//   --fast     use the scalar-inlined intersection kernel
//   --inlined  use the compiler-style kernel: calls gone, intermediate objects KEPT.
//              The gap idiomatic -> inlined is what an inliner can deliver; the further gap
//              inlined -> fast is what scalar replacement would have to add on top.
//   --preview  render small and quickly -- a sanity check, not a picture
//   --quiet    skip the self-tests, so a timing run measures only the render
//   --threads=N  render on N parallel tasks (default 1: no task at all). The image is the same for
//              every N -- the checksum below is the check.
let opts    = CliArgs::parse(args())
let fast    = opts.hasFlag("fast")
let inlined = opts.hasFlag("inlined")
let kernel  = if fast { 1 } else if inlined { 2 } else { 0 }
let preview = opts.hasFlag("preview")
let threads = match parseInt(opts.getOptOr("threads", "1")) {
    Ok(n)  => if n < 1 { 1 } else { n },
    Err(_) => panic("--threads needs a whole number, e.g. --threads=4"),
}

println("Skarn raytracer -- three intersection kernels: idiomatic / compiler-inlined / hand-scalarized")
println("")

let mut testsOk = true
if !opts.hasFlag("quiet") {
    testsOk = vecSelfTest()      println("")
    testsOk = bmpSelfTest()      && testsOk  println("")
    testsOk = geometrySelfTest() && testsOk  println("")
    testsOk = cameraSelfTest()   && testsOk  println("")
    testsOk = materialSelfTest() && testsOk  println("")
}

let width   = if preview { 160 } else { WIDTH }
let height  = if preview {  90 } else { HEIGHT }
let samples = if preview {   4 } else { SAMPLES }

gcResetStats()
let t0   = nanoTime()
let img  = render(width, height, samples, kernel, threads)
let ns   = nanoTime() - t0
let g    = gcStats()
let rays = width * height * samples

let data = img.toBmp()
let sum  = crc32(data)

println("kernel:   ${if kernel == 1 { "FastSphere (scalar-inlined by hand)" }
                     else if kernel == 2 { "InlinedSphere (compiler-style: calls gone, objects kept)" }
                     else { "Sphere (idiomatic Vec3)" }}")
println("rendered  ${width}x${height}, ${samples} samples/pixel, depth ${MAX_DEPTH}  (${rays} primary rays)")
println("  tasks   ${if threads <= 1 { "none (sequential)" } else { "${threads} in parallel" }}")
println("  wall    ${ns / 1000000} ms   --   ${ns / rays} ns per primary ray")
if threads <= 1 {
    println("  alloc   ${g.bytesAlloced / 1048576.0} MiB in ${g.collections} collections")
    println("  GC      ${g.gcNanosTotal / 1000000.0} ms  (${100.0 * g.gcNanosTotal / toDouble(ns)} % of wall)")
} else {
    // The counters belong to THIS heap; each task allocates on its own, where nothing here sees it.
    println("  alloc   (in the tasks' own heaps -- not counted here)")
}
// The pinned checksum. Both kernels must reach it, so this one comparison covers both
// "the renderer still produces the same picture" and "the two kernels still agree".
let expected = if preview { CRC_PREVIEW } else { CRC_FULL }
let imageOk  = sum == expected
if imageOk {
    println("  image   crc32 ${sum} -- matches the pinned value, ${len(data)} bytes")
} else {
    println("  image   crc32 ${sum} -- MISMATCH, expected ${expected}, ${len(data)} bytes")
}

let path = if kernel == 1 { "raytracer_fast.bmp" }
           else if kernel == 2 { "raytracer_inlined.bmp" }
           else { "raytracer.bmp" }
match writeFile(path, data) {
    Ok(_)  => println("wrote ${path}"),
    Err(e) => println("could not write ${path}: ${e}"),
}

println("")
if testsOk && imageOk {
    println("all self-checks passed")
} else {
    // panic aborts with a located message and a non-zero exit code, which is what makes
    // `static_vmrun demo/raytracer/main.skn --preview` usable as a build gate.
    panic("raytracer self-check FAILED -- see the report above")
}
