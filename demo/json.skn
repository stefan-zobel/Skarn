// json.skn -- using the std::json LIBRARY (parse -> navigate -> re-serialize).
// Contrast demo/json_parser.skn, which builds a parser FROM SCRATCH; here we just
// `use` the shipped module. Serialization runs through the StringBuilder (O(n)) with
// correct escaping.
use std::json::*

let src = "{\"name\":\"Ada Lovelace\",\"age\":36,\"active\":true,\"langs\":[\"Skarn\",\"Rust\"],\"note\":\"tab\\ttab\"}"

let doc = match Json::parse(src) {
  Ok(j) => j,
  Err(e) => { println("parse error: " + e)  Null },
}

// ---- navigate with typed accessors ----
match doc.getField("name") { Some(Text(s)) => println("name   = " + s), _ => println("name   = ?") }
match unwrap(doc.getField("age")).asInt() { Some(n) => println("age    = " + toString(n)), None => println("age    = ?") }
match doc.getField("active") { Some(Boolean(b)) => println("active = " + toString(b)), _ => println("active = ?") }
match doc.getField("langs") {
  Some(Arr(xs)) => println("langs  = " + toString(len(xs)) + " item(s)"),
  _ => println("langs  = ?"),
}

// ---- re-serialize: compact (round-trips the structure) ----
println("")
println("compact:")
println(doc.stringify())

// ---- re-serialize: pretty, 2-space indent ----
println("")
println("pretty:")
println(doc.stringifyPretty(2))

// ---- a malformed input reports a located error ----
println("")
match Json::parse("{\"a\":}") {
  Ok(_)  => println("unexpected ok"),
  Err(e) => println("malformed -> Err: " + e),
}
