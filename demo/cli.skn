// std::cli -- a spec-free command-line argument parser (pure Skarn, native-free).
// It classifies the REAL command line. Run it with arguments to see them sorted, e.g.:
//   static_vmrun demo/cli.skn build --opt=O2 --output=out.bin -v main.skn -- --literal
use std::env::*
use std::cli::*

// args() is everything after the script path (an Array[String]); toVec lifts it into the
// Vec[String] that CliArgs::parse expects. The parser needs no per-option spec.
let c = CliArgs::parse(toVec(args()))

// Options are `--name=value`; read them with a default or as an Option.
println("opt --opt    : ${c.getOptOr("opt", "(none)")}")
match c.getOpt("output") {
  Some(v) => println("opt --output : ${v}"),
  None    => println("opt --output : (not given)")
}

// Flags are a bare `--name` or grouped short `-abc` (letters only).
println("flag --verbose : ${c.hasFlag("verbose")}")
println("flag -v        : ${c.hasFlag("v")}")

// Positionals are everything that is neither a flag nor an option -- plus anything after `--`.
println("positionals (${c.numPositionals()}):")
let mut i = 0
while i < c.numPositionals() {
  match c.positionalAt(i) {
    Some(p) => println("  [${i}] ${p}"),
    None    => println("  [${i}] (none)")
  }
  i = i + 1
}

// With no arguments every query above is empty/false -- pass some to watch them populate.
if c.numPositionals() == 0 && !c.hasFlag("verbose") {
  println("(no arguments -- try: static_vmrun demo/cli.skn build --opt=O2 -v main.skn)")
}
