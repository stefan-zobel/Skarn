{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Skarn",
  "scopeName": "source.skarn",
  "fileTypes": ["skn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#builtin-functions" },
    { "include": "#builtin-types" },
    { "include": "#prelude-types" },
    { "include": "#constructors-and-types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.skarn",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.skarn",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },

    "raw-strings": {
      "comment": "Raw strings r\"...\" and r#\"...\"# ... r####\"...\"####. Verbatim bytes: no escapes, no ${} interpolation. The closing delimiter is a quote followed by exactly as many # as opened.",
      "patterns": [
        {
          "name": "string.quoted.other.raw.skarn",
          "begin": "\\br(#*)\"",
          "end": "\"\\1",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.skarn" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.skarn" }
          }
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.skarn",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.skarn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.skarn" }
      },
      "patterns": [
        { "include": "#string-escapes" },
        { "include": "#interpolation" }
      ]
    },

    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.skarn",
          "match": "\\\\[nrt0\\\\\"'$]"
        },
        {
          "name": "invalid.illegal.unknown-escape.skarn",
          "match": "\\\\."
        }
      ]
    },

    "interpolation": {
      "comment": "String interpolation \"${ expr }\" (and \"${ expr :spec }\"). Switches back into the main expression context; braces are balanced by the recursive #interp-body.",
      "name": "meta.interpolation.skarn",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.skarn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.skarn" }
      },
      "patterns": [
        {
          "comment": "format specifier at the tail of a hole: ${e:>08.3f}",
          "match": "(:)\\s*([<>^]?0?\\d*(?:\\.\\d+)?[xXbodfgs]?)\\s*(?=\\})",
          "captures": {
            "1": { "name": "punctuation.separator.format.skarn" },
            "2": { "name": "constant.other.format-spec.skarn" }
          }
        },
        { "include": "#interp-body" }
      ]
    },

    "interp-body": {
      "comment": "Everything legal inside an interpolation hole, plus balanced nested braces (struct literals, blocks, and further nested strings).",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#interp-body" }
          ]
        },
        { "include": "#comments" },
        { "include": "#raw-strings" },
        { "include": "#strings" },
        { "include": "#chars" },
            { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#declarations" },
        { "include": "#builtin-functions" },
        { "include": "#builtin-types" },
        { "include": "#prelude-types" },
        { "include": "#constructors-and-types" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "chars": {
      "comment": "Char literals 'A' / '\\n' -- byte-valued Ints, there is no scalar Char type.",
      "name": "string.quoted.single.skarn",
      "match": "'(\\\\[nrt0\\\\\"']|[^'\\\\])'",
      "captures": {
        "1": { "name": "constant.character.escape.skarn" }
      }
    },

    "numbers": {
      "comment": "`_` is a digit separator (between digits only), so every digit class admits a trailing `[0-9..._]*`. The leading character stays a bare digit class, which is what keeps `_1` an identifier.",
      "patterns": [
        {
          "name": "constant.numeric.hex.skarn",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.octal.skarn",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.binary.skarn",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.skarn",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)\\b"
        },
        {
          "name": "constant.numeric.integer.skarn",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.skarn",
          "match": "\\b(if|else|match|while|for|loop|break|continue|return|in)\\b"
        },
        {
          "name": "constant.language.boolean.skarn",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.skarn",
          "match": "\\bself\\b"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "comment": "function definition: highlight the name after `fn`",
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.skarn" },
            "2": { "name": "entity.name.function.skarn" }
          }
        },
        {
          "name": "storage.type.skarn",
          "match": "\\b(fn|let|struct|enum|trait|impl)\\b"
        },
        {
          "name": "storage.modifier.skarn",
          "match": "\\b(mut|const|pub|dyn|transparent|import|use)\\b"
        }
      ]
    },

    "builtin-types": {
      "name": "support.type.builtin.skarn",
      "match": "\\b(Array|Bool|Bytes|Char|Double|Int|List|Map|Self|String|Vec)\\b"
    },

    "prelude-types": {
      "comment": "Prelude / std types, enums and constants.",
      "name": "support.type.prelude.skarn",
      "match": "\\b(Accepted|ActiveConn|ActiveListener|ActorFn|ActorId|Arr|AskError|Boolean|ByteReader|Captures|Child|CliArgs|Clone|CLOSED|DateTime|Duration|E|Eq|Err|File|FileMode|Format|Framing|GcStats|Hashable|HttpResponse|Inbox|InboxRef|Incoming|IncomingClients|Instant|Integer|IntoIterator|Iterable|Iterator|Json|JsonEntry|Level|Log|MacOS|Mail|Match|MustUse|NbConn|NbListener|None|Obj|Ok|Option|Ord|Os|Other|PI|Pid|ProcessOutput|ProcessText|READABLE|Received|Regex|RegexError|Resp|RespClient|RespReader|RestartLimit|Result|Rng|Sendable|SendResult|Set|Sink|Slot|SlotChild|SocketHandOff|SockEvent|SockEvents|Some|Stopwatch|Strategy|StringBuilder|Supervised|SupervisorSpec|Task|TaskFn|TcpConn|TcpListener|Unwrap|Windows|WRITABLE)\\b"
    },

    "builtin-functions": {
      "comment": "Builtins, natives and prelude free functions the static compiler recognizes.",
      "name": "support.function.builtin.skarn",
      "match": "\\b(abs|absInt|accept|acos|activate|actorFn|actorId|add|addDuration|all|any|append|appendArrayHeader|appendBulk|appendByte|appendBytes|appendCodePoint|appendError|appendFile|appendInteger|appendNull|appendNullArray|appendResp|appendSimple|appendTextFile|args|array|asArr|asBool|asDouble|asin|asInt|ask|asMap|asObj|assert|asStr|at|atan|atan2|atEnd|atLeast|buffered|build|bytes|call|captures|capturesAll|capturesFrom|cbrt|ceil|chain|charAt|charCount|chars|charStr|child|childIn|choice|choiceWeighted|chunks|clamp|clone|close|codePoint|codePointToStr|collect|compile|compileWith|connect|contains|copyFile|cos|count|crc32|crc32Str|currentOs|dateOnly|dateTime|days|daysInMonth|debug|dedup|delete|deleteFile|difference|drop|dropWhile|durationBetween|elapsedMillis|elapsedNanos|empty|emptyArray|encode|encodeCommand|endsWith|enumerate|error|exp|expect|f64ToBytes|feed|fileExists|fileSize|fillDoubles|fillU32|filter|find|flatMap|floor|fold|forEach|format|fromBytes|fromChars|fromDateTime|fromHex|fromSeed|fromState|fromVec|gcd|gcResetStats|gcStats|get|getEnv|getField|getOpt|getOptOr|getOr|getOrElse|getOrPut|group|groupNamed|handOff|has|hasControl|hasFlag|hasSubstr|hours|httpGet|hypot|inDays|indexOf|indexOfByte|info|inHours|inMillis|inMinutes|inSeconds|insert|inspect|instantFromMillis|intersect|intoIter|isAfter|isAsciiAlpha|isAsciiAlphanumeric|isAsciiControl|isAsciiDigit|isAsciiLower|isAsciiPrintable|isAsciiUpper|isAsciiWhitespace|isBefore|isDir|isDisjoint|isEmpty|isErr|isFile|isInfinite|isLeapYear|isMatch|isMember|isNaN|isNone|isNull|isOk|isSome|isSubset|iter|iterate|join|jump|keys|label|lastIndexOf|lcm|len|lessThan|lines|listDir|listen|ln|localPort|log10|log2|mainInbox|map|mapErr|max|maxBy|maxOf|messages|millis|millisTime|min|minBy|minOf|minutes|mkdir|monitor|murmur3|murmur3Str|nanoTime|negate|new|newBoundedInbox|newBoundedSlot|newInbox|newSlot|next|nextBool|nextCommand|nextDouble|nextDoubleRange|nextGaussian|nextGaussianMS|nextInt|nextInt48|nextIntBounded|nextU32|nonBlocking|nonBlockingConn|now|nthChar|numPositionals|ok|okOr|once|openFile|optionAndThen|optionMap|ordinal|padEnd|padStart|panic|parse|parseDouble|parseInt|parseIso|partition|peek|peekable|pid|pipeline|poll|pop|position|positionalAt|pow|print|println|product|push|range|rank|read|readAll|readAllStdin|readBytes|readFile|readI32LE|readLine|readStr|readTextFile|readU16LE|readU32LE|readU8|readVarI|readVarU|receive|receiveTimeout|recv|recvAll|recvLine|reduce|ref|release|remaining|remove|rename|render|repeat|repeatStr|replace|replaceAllRe|replaceRe|resultAndThen|resultMap|round|roundHalfToEven|run|runText|runWith|sample|scale|scan|search|searchAll|searchFrom|seconds|select|send|sendStr|setSendTimeout|setTimeout|sh|sha256|sha256Hex|sha256HexStr|sha256Str|shuffle|sign|signInt|sin|size|sleep|slice|sliceBytes|sort|sortBy|sorted|spawn|spawnActor|spawnActorBounded|spawnBounded|split|splitRe|splitRng|sqrt|start|startLogger|startStopwatch|startsWith|stepBy|stop|stopActor|stopRequested|stringBuilder|stringBuilderCap|stringify|stringifyChecked|stringifyPretty|sub|subBytes|subDuration|sum|supervise|superviseWith|sync|take|takeWhile|tan|taskFn|toActor|toBytes|toDateTime|toDouble|toEpochMillis|toFile|toHex|toInt|toIntChecked|toIso|toLower|toMap|toString|toUpper|toVec|trim|trimEnd|trimStart|trunc|trySend|union|unwrap|unwrapErr|unwrapOr|unzip|upsert|values|vec|warn|watch|weekday|windows|words|write|writeBytes|writeFile|writeI32LE|writeStr|writeTextFile|writeU16LE|writeU32LE|writeU8|writeVarI|writeVarU|zip)\\b(?=\\s*\\()"
    },

    "constructors-and-types": {
      "comment": "Any other UIdent (first char A-Z): user types, enum variants, constructors, traits, type variables.",
      "name": "entity.name.type.skarn",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.skarn",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.pipe.skarn",
          "match": "\\|>"
        },
        {
          "comment": "Range patterns: `lo..hi` (inclusive) and `lo..<hi` (exclusive upper bound). Must precede the comparison rule, which would otherwise claim the trailing `<` on its own.",
          "name": "keyword.operator.range.skarn",
          "match": "\\.\\.<|\\.\\."
        },
        {
          "comment": "The bare `!` excludes `!=` via lookahead: this rule precedes the comparison rule and would otherwise split `!=` into `!` + `=`.",
          "name": "keyword.operator.logical.skarn",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "comment": "Compound assignment, longest-first. Must precede the comparison and bitwise rules: those match a single `<`/`>`/`&` at the same position and would split `>>>=` (the language's only four-character token) into three operators.",
          "name": "keyword.operator.assignment.compound.skarn",
          "match": ">>>=|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "comment": "Shifts, longest-first. Must precede the comparison rule, which matches a single `<`/`>` at the same position and would split `>>>` into three comparisons. `>=`/`<=` are unaffected: no alternative here matches a `>`/`<` followed by `=` (`>>=` and friends are claimed by the compound rule above).",
          "name": "keyword.operator.bitwise.skarn",
          "match": ">>>|<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.comparison.skarn",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.skarn",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.skarn",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.try.skarn",
          "match": "\\?"
        },
        {
          "comment": "Pattern binding `n @ sub`. Shares no prefix with any other lexeme, so its position in this list carries no ordering obligation.",
          "name": "keyword.operator.binding.skarn",
          "match": "@"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.qualifier.skarn",
          "match": "::"
        },
        {
          "name": "punctuation.separator.type.skarn",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.skarn",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.skarn",
          "match": ","
        },
        {
          "name": "punctuation.accessor.skarn",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.map.skarn",
          "match": "#"
        }
      ]
    }
  }
}
