{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Skarn",
  "scopeName": "source.skarn",
  "fileTypes": ["skn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#builtin-functions" },
    { "include": "#builtin-types" },
    { "include": "#prelude-types" },
    { "include": "#constructors-and-types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.skarn",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.skarn",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },

    "raw-strings": {
      "comment": "Raw strings r\"...\" and r#\"...\"# ... r####\"...\"####. Verbatim bytes: no escapes, no ${} interpolation. The closing delimiter is a quote followed by exactly as many # as opened.",
      "patterns": [
        {
          "name": "string.quoted.other.raw.skarn",
          "begin": "\\br(#*)\"",
          "end": "\"\\1",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.skarn" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.skarn" }
          }
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.skarn",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.skarn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.skarn" }
      },
      "patterns": [
        { "include": "#string-escapes" },
        { "include": "#interpolation" }
      ]
    },

    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.skarn",
          "match": "\\\\[nrt0\\\\\"'$]"
        },
        {
          "name": "invalid.illegal.unknown-escape.skarn",
          "match": "\\\\."
        }
      ]
    },

    "interpolation": {
      "comment": "String interpolation \"${ expr }\" (and \"${ expr :spec }\"). Switches back into the main expression context; braces are balanced by the recursive #interp-body.",
      "name": "meta.interpolation.skarn",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.skarn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.skarn" }
      },
      "patterns": [
        {
          "comment": "format specifier at the tail of a hole: ${e:>08.3f}",
          "match": "(:)\\s*([<>^]?0?\\d*(?:\\.\\d+)?[xXbodfgs]?)\\s*(?=\\})",
          "captures": {
            "1": { "name": "punctuation.separator.format.skarn" },
            "2": { "name": "constant.other.format-spec.skarn" }
          }
        },
        { "include": "#interp-body" }
      ]
    },

    "interp-body": {
      "comment": "Everything legal inside an interpolation hole, plus balanced nested braces (struct literals, blocks, and further nested strings).",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#interp-body" }
          ]
        },
        { "include": "#comments" },
        { "include": "#raw-strings" },
        { "include": "#strings" },
        { "include": "#chars" },
            { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#declarations" },
        { "include": "#builtin-functions" },
        { "include": "#builtin-types" },
        { "include": "#prelude-types" },
        { "include": "#constructors-and-types" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "chars": {
      "comment": "Char literals 'A' / '\\n' -- byte-valued Ints, there is no scalar Char type.",
      "name": "string.quoted.single.skarn",
      "match": "'(\\\\[nrt0\\\\\"']|[^'\\\\])'",
      "captures": {
        "1": { "name": "constant.character.escape.skarn" }
      }
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.skarn",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.skarn",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.skarn",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.skarn",
          "match": "\\b\\d+(?:\\.\\d+(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.skarn",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.skarn",
          "match": "\\b(if|else|match|while|for|loop|break|continue|return|in)\\b"
        },
        {
          "name": "constant.language.boolean.skarn",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.skarn",
          "match": "\\bself\\b"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "comment": "function definition: highlight the name after `fn`",
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.skarn" },
            "2": { "name": "entity.name.function.skarn" }
          }
        },
        {
          "name": "storage.type.skarn",
          "match": "\\b(fn|let|struct|enum|trait|impl)\\b"
        },
        {
          "name": "storage.modifier.skarn",
          "match": "\\b(mut|const|pub|dyn|transparent|import|use)\\b"
        }
      ]
    },

    "builtin-types": {
      "name": "support.type.builtin.skarn",
      "match": "\\b(Array|Bool|Bytes|Char|Double|Int|List|Map|Self|String|Vec)\\b"
    },

    "prelude-types": {
      "comment": "Prelude / std types, enums and constants.",
      "name": "support.type.prelude.skarn",
      "match": "\\b(ByteReader|CliArgs|Clone|DateTime|Duration|E|Err|Format|GcStats|Hashable|HttpResponse|Instant|IntoIterator|Iterable|Iterator|Json|JsonEntry|None|Ok|Option|Ord|PI|ProcessOutput|ProcessText|Result|Rng|Set|Some|Stopwatch|StringBuilder|TcpConn|TcpListener|Unwrap)\\b"
    },

    "builtin-functions": {
      "comment": "Builtins, natives and prelude free functions the static compiler recognizes.",
      "name": "support.function.builtin.skarn",
      "match": "\\b(abs|absInt|accept|acos|addDuration|addDurations|all|any|append|appendByte|appendBytes|appendCodePoint|appendFile|appendTextFile|args|array|asArr|asBool|asDouble|asInt|asMap|asObj|asStr|asin|assert|at|atEnd|atan|atan2|build|bytes|cbrt|ceil|chain|charAt|charCount|charStr|chars|choice|choiceWeighted|clamp|clone|close|closeListener|codePoint|codePointToStr|collect|connect|contains|copyFile|cos|count|crc32|crc32Str|dateOnly|dateTime|days|daysInMonth|delete|deleteFile|difference|drop|dropWhile|durationBetween|elapsedMillis|elapsedNanos|empty|emptyArray|endsWith|enumerate|exp|expect|f64ToBytes|fileExists|fileSize|fillDoubles|fillU32|filter|find|flatMap|floor|fold|forEach|fromBytes|fromChars|fromDateTime|gcResetStats|gcStats|gcd|get|getEnv|getField|getOpt|getOptOr|getOr|getOrElse|getOrPut|has|hasControl|hasFlag|hasSubstr|hours|httpGet|hypot|inDays|inHours|inMillis|inMinutes|inSeconds|indexOf|insert|instantFromMillis|intersect|intoIter|isAfter|isAsciiAlpha|isAsciiAlphanumeric|isAsciiControl|isAsciiDigit|isAsciiLower|isAsciiPrintable|isAsciiUpper|isAsciiWhitespace|isBefore|isDir|isDisjoint|isEmpty|isErr|isFile|isInfinite|isLeapYear|isMember|isNaN|isNone|isNull|isOk|isSome|isSubset|iter|iterate|join|jump|keys|lastIndexOf|lcm|len|lessThan|lines|listDir|listen|ln|log10|log2|map|mapErr|max|maxBy|maxOf|millis|millisTime|min|minBy|minOf|minutes|mkdir|murmur3|murmur3Str|nanoTime|negateDuration|next|nextBool|nextDouble|nextDoubleRange|nextGaussian|nextGaussianMS|nextInt|nextInt48|nextIntBounded|nextU32|now|nthChar|numPositionals|ok|okOr|once|optionAndThen|optionMap|padEnd|padStart|panic|parse|parseArgs|parseDouble|parseInt|parseIso|partition|pop|position|positionalAt|pow|print|println|product|push|range|rawRun|readAllStdin|readBytes|readFile|readI32LE|readLine|readStr|readTextFile|readU16LE|readU32LE|readU8|readVarI|readVarU|reader|recv|recvAll|recvLine|reduce|remaining|remove|rename|repeat|repeatStr|replace|resultAndThen|resultMap|rngFromState|round|roundHalfToEven|run|runText|runWith|sample|sbLen|scaleDuration|scan|seconds|seedRng|send|sendStr|set|setOf|setTimeout|sh|sha256|sha256Hex|sha256HexStr|sha256Str|shuffle|sign|signInt|sin|size|slice|sliceBytes|sort|sortBy|sorted|split|splitRng|sqrt|startStopwatch|startsWith|streamArray|streamBytes|streamList|streamVec|stringBuilder|stringBuilderCap|stringify|stringifyChecked|stringifyPretty|subDuration|subDurations|sum|take|takeWhile|tan|tcpAccept|tcpClose|tcpConnect|tcpListen|tcpRecv|tcpSend|tcpSetTimeout|toBytes|toDateTime|toEpochMillis|toHex|toInt|toIntChecked|toIso|toLower|toMap|toStream|toString|toUpper|toVec|trim|trimEnd|trimStart|trunc|union|unwrap|unwrapErr|unwrapOr|unzip|upsert|values|vec|weekday|writeBytes|writeFile|writeI32LE|writeStr|writeTextFile|writeU16LE|writeU32LE|writeU8|writeVarI|writeVarU|zip)\\b(?=\\s*\\()"
    },

    "constructors-and-types": {
      "comment": "Any other UIdent (first char A-Z): user types, enum variants, constructors, traits, type variables.",
      "name": "entity.name.type.skarn",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.skarn",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.pipe.skarn",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.logical.skarn",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.skarn",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.skarn",
          "match": ">>>|<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.assignment.skarn",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.skarn",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.try.skarn",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.range.skarn",
          "match": "\\.\\."
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.qualifier.skarn",
          "match": "::"
        },
        {
          "name": "punctuation.separator.type.skarn",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.skarn",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.skarn",
          "match": ","
        },
        {
          "name": "punctuation.accessor.skarn",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.map.skarn",
          "match": "#"
        }
      ]
    }
  }
}
