// CLAIM: what spawn copies to another heap must be plain data -- a function value inside the argument is a compile error, not a run-time failure.
// GUIDE: 21 (Running functions in parallel)
// EXPECT: fail cannot be sent to a task: it contains a function value
use std::task::*

struct Job { n: Int, f: fn(Int) -> Int }

fn run(j: Job) -> Int { j.n }

println(spawn(run, Job { n: 1, f: fn(x: Int) -> Int { x } }).join())
