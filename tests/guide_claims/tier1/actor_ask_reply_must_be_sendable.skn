// CLAIM: `ask` makes an inbox for the reply, so the reply type must be plain data like any message type --
//        a function value as the reply is a compile error.
// GUIDE: 20 (Actors: long-lived, talking by messages)
// EXPECT: fail the reply (fn(Int) -> Int) cannot be sent
use std::actor::*

fn f(inbox: Inbox[Pid[fn(Int) -> Int]], unused: Int) -> () {}

let p = spawnActor(f, 0)
match ask(p, fn(me) { me }, 100) {
  Ok(_) => println("?"),
  Err(e) => println(e),
}
