// CLAIM: `+= -= *= /= %=` and the bitwise/shift six `&= |= ^= <<= >>= >>>=` mean exactly `a = a op b`,
//        on a variable, a struct field and an element — Int and Double alike for the arithmetic forms,
//        with the same Int->Double widening at the boundary. `>>=` is arithmetic, `>>>=` logical.
// GUIDE: SkarnGuide.md 5 (Compound assignment)
// EXPECT: ok 2 | 1 | 10 | 11.0 | 40 | -8 | 140737488355320
let mut n = 10
n += 5          // 15
n *= 2          // 30
n -= 2          // 28
n /= 4          // 7
n %= 5          // 2

struct Counter { hits: Int }
let mut c = Counter { hits: 0 }
c.hits += 1

let mut v = array(3, 0)
v[1] += 10

let mut d = 10.0
d += 1          // an Int operand widens into a Double target

let mut flags = 0b1100
flags &= 0b1010 // 8
flags |= 0b0011 // 11
flags ^= 0b0001 // 10
flags <<= 2     // 40

let mut neg = -16
neg >>= 1       // -8, arithmetic: the sign is preserved

let mut log = -16
log >>>= 1      // logical over the 48-bit value: 0xFFFFFFFFFFF0 >> 1 = 0x7FFFFFFFFFF8

println("${n} | ${c.hits} | ${v[1]} | ${d} | ${flags} | ${neg} | ${log}")
