// CLAIM: a task works on a COPY of its argument taken when it starts -- the parent's later change
//        does not reach it, and nothing the task does reaches the parent.
// GUIDE: SkarnGuide.md 21 (Running functions in parallel)
// EXPECT: ok task saw 2, parent has 3
use std::task::*

fn size(v: Vec[Int]) -> Int { len(v) }

let mut v: Vec[Int] = vec()
push(v, 1)
push(v, 2)
let t = spawn(size, v)
push(v, 3)
match t.join() {
  Ok(n) => println("task saw ${n}, parent has ${len(v)}"),
  Err(e) => println(e),
}
