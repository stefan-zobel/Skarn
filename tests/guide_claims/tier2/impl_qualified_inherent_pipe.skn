// CLAIM: the qualified inherent form works in a pipe — `x |> Type::method` — so an inherent method
//        can take part in a `|>` chain, which the `.` form cannot.
// GUIDE: 16 (method-call syntax — qualified inherent call)
// EXPECT: ok 14
struct Point { x: Int, y: Int }
impl Point { fn sum(self) -> Int { self.x + self.y }
             fn scale(self, k: Int) -> Point { Point { x: self.x * k, y: self.y * k } } }

println(Point { x: 3, y: 4 } |> Point::scale(2) |> Point::sum)
